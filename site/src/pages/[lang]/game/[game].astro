---
// Halaman per-game — fokus satu game: kode aktif + event berlangsung + tautan
// karakter. Di-generate untuk tiap game berkode × bahasa. Bagus untuk SEO
// ("genshin impact kode redeem"). Template untuk semua game.
import Base from "../../../layouts/Base.astro";
import Header from "../../../components/Header.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import Footer from "../../../components/Footer.astro";
import CodeCard from "../../../components/CodeCard.astro";
import CopyScript from "../../../components/CopyScript.astro";
import CountdownScript from "../../../components/CountdownScript.astro";
import EventCard from "../../../components/EventCard.astro";
import EventModal from "../../../components/EventModal.astro";
import { LANGS, t } from "../../../lib/i18n.mjs";
import { route } from "../../../lib/routes.mjs";
import { redeemInfo } from "../../../lib/redeem.mjs";
import { monthYear } from "../../../lib/seo.mjs";
import { loadCodes } from "../../../lib/codes.mjs";
import { loadEvents } from "../../../lib/events.mjs";
import { loadCatalog } from "../../../lib/catalog.mjs";

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  const withCodes = catalog.games.filter((g) => g.hasCodes);
  return LANGS.flatMap((lang) => withCodes.map((g) => ({ params: { lang, game: g.id }, props: { gameMeta: g } })));
}

const { lang, game } = Astro.params;
const { gameMeta } = Astro.props;
const tr = t(lang);
const id = lang === "id";

const [codes, events] = await Promise.all([loadCodes(), loadEvents(lang)]);
const gameCodes = codes.active.filter((c) => c.game === game);
const gameEvents = events.events.filter((e) => e.game === game);

// Cara redeem (spesifik per game, terverifikasi — lihat lib/redeem.mjs).
const rd = redeemInfo(game, lang);

const my = monthYear(lang);
const meta = {
  title: id
    ? `Kode Redeem ${gameMeta.name} ${my} (Masih Aktif) — KodeGG`
    : `${gameMeta.name} Redeem Codes ${my} (Active) — KodeGG`,
  desc: id
    ? `Kode redeem ${gameMeta.name} terbaru ${my} yang masih aktif + event berlangsung. Diperbarui otomatis tiap jam.`
    : `Latest active ${gameMeta.name} redeem codes for ${my} plus live events. Auto-updated hourly.`,
};

const site = Astro.site.href.replace(/\/$/, "");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: id ? "Beranda" : "Home", item: `${site}/${lang}` },
      { "@type": "ListItem", position: 2, name: tr("nav.discover"), item: `${site}${route("discover", lang)}` },
      { "@type": "ListItem", position: 3, name: gameMeta.name },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoGame",
    name: gameMeta.name,
    url: `${site}/${lang}/game/${game}`,
    ...(gameMeta.cover ? { image: gameMeta.cover } : {}),
    ...(gameMeta.genreLabels?.length ? { genre: gameMeta.genreLabels } : {}),
    gamePlatform: ["Android", "iOS"],
    ...(gameMeta.rating && gameMeta.ratingCount
      ? {
          aggregateRating: {
            "@type": "AggregateRating",
            ratingValue: gameMeta.rating,
            ratingCount: gameMeta.ratingCount,
            bestRating: 5,
            worstRating: 1,
          },
        }
      : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: id ? `Cara redeem kode ${gameMeta.name}` : `How to redeem ${gameMeta.name} codes`,
    description: id
      ? `Langkah-langkah menukar kode redeem ${gameMeta.name} langsung di dalam game.`
      : `Step-by-step guide to redeem ${gameMeta.name} codes inside the game.`,
    step: rd.ingame.map((s, i) => ({ "@type": "HowToStep", position: i + 1, name: s, text: s })),
  },
];
---

<Base lang={lang} title={meta.title} description={meta.desc} paths={{ id: `/id/game/${game}`, en: `/en/game/${game}` }} jsonLd={jsonLd}>
  <Header lang={lang} active={null} paths={{ id: `/id/game/${game}`, en: `/en/game/${game}` }} />
  <Breadcrumb
    items={[
      { label: id ? "Beranda" : "Home", href: route("home", lang) },
      { label: tr("nav.discover"), href: route("discover", lang) },
      { label: gameMeta.name },
    ]}
  />
  <main>
    <!-- HERO -->
    <section style="max-width:1280px; margin:0 auto; padding:44px 28px 8px; display:flex; align-items:center; gap:18px; flex-wrap:wrap;">
      {gameMeta.cover && <img src={gameMeta.cover} alt={gameMeta.name} width="72" height="72" style="width:72px; height:72px; border-radius:16px; object-fit:cover; border:1px solid var(--line);" onerror="this.style.display='none'" />}
      <div>
        <h1 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:34px; letter-spacing:-0.02em; color:#fff; margin:0;">{gameMeta.name}</h1>
        <div style="font-family:'Space Mono',monospace; font-size:12px; color:var(--faint); margin-top:6px;">
          {gameMeta.genreLabels?.join(" · ")}{gameMeta.rating ? ` · ★ ${gameMeta.rating}` : ""}
        </div>
      </div>
    </section>

    <!-- KODE -->
    <section style="max-width:1280px; margin:0 auto; padding:24px 28px 8px;">
      <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:16px; gap:12px;">
        <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:22px; color:var(--txt); margin:0;">
          {id ? "Kode aktif" : "Active codes"} <span style="color:var(--faint); font-size:16px;">({gameCodes.length})</span>
        </h2>
        <a href={`${route("codes", lang)}?game=${game}`} style="font-family:'Space Mono',monospace; font-size:12px; font-weight:700; color:var(--acc); text-decoration:none;">{id ? "Halaman kode" : "Codes page"} →</a>
      </div>
      {
        gameCodes.length > 0 ? (
          <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:18px;">
            {gameCodes.map((card) => <CodeCard card={card} lang={lang} linkGame={false} />)}
          </div>
        ) : (
          <p style="color:var(--muted); font-size:15px;">{id ? "Belum ada kode aktif saat ini." : "No active codes right now."}</p>
        )
      }
    </section>

    <!-- CARA REDEEM — spesifik per game (data terverifikasi di lib/redeem.mjs) -->
    <section style="max-width:1280px; margin:0 auto; padding:28px 28px 8px;">
      <div style="display:flex; align-items:baseline; gap:12px; flex-wrap:wrap; margin-bottom:6px;">
        <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:22px; color:var(--txt); margin:0;">
          {id ? `Cara redeem kode ${gameMeta.name}` : `How to redeem ${gameMeta.name} codes`}
        </h2>
        {rd.req && (
          <span style="font-family:'Space Mono',monospace; font-size:11.5px; font-weight:700; color:var(--warn); background:rgba(255,177,60,0.1); border:1px solid rgba(255,177,60,0.28); padding:5px 10px; border-radius:999px;">
            {id ? "Syarat" : "Requires"}: {rd.req}
          </span>
        )}
      </div>
      <p style="font-size:14px; color:var(--muted); margin:0 0 18px;">
        {id
          ? "Kode ditukar langsung di game (atau lewat web bila tersedia). Hadiah masuk ke in-game mail."
          : "Codes are redeemed in-game (or on the web where available). Rewards arrive in your in-game mail."}
      </p>

      <div style={`display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px; max-width:${rd.web ? "880px" : "560px"};`}>
        {rd.web && (
          <div style="background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:20px;">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:14px;">
              <span style="font-family:'Space Mono',monospace; font-size:11px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--acc);">{id ? "Lewat web" : "Via web"}</span>
              <a href={rd.web} target="_blank" rel="noopener nofollow" style="font-family:'Space Mono',monospace; font-size:11.5px; font-weight:700; color:var(--ink); background:var(--acc); padding:6px 12px; border-radius:9px; text-decoration:none;">{id ? "Buka halaman resmi ↗" : "Open official page ↗"}</a>
            </div>
            <ol style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:11px;">
              {rd.webSteps.map((s, i) => (
                <li style="display:flex; gap:11px; align-items:flex-start; font-size:14px; line-height:1.5; color:var(--txt);">
                  <span style="flex:none; width:22px; height:22px; border-radius:7px; background:var(--surface2); border:1px solid var(--line2); font-family:'Space Mono',monospace; font-size:11px; font-weight:700; color:var(--acc); display:flex; align-items:center; justify-content:center;">{i + 1}</span>
                  <span>{s}</span>
                </li>
              ))}
            </ol>
          </div>
        )}

        <div style="background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:20px;">
          <div style="margin-bottom:14px;">
            <span style="font-family:'Space Mono',monospace; font-size:11px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--acc2);">{id ? "Di dalam game" : "In-game"}</span>
          </div>
          <ol style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:11px;">
            {rd.ingame.map((s, i) => (
              <li style="display:flex; gap:11px; align-items:flex-start; font-size:14px; line-height:1.5; color:var(--txt);">
                <span style="flex:none; width:22px; height:22px; border-radius:7px; background:var(--surface2); border:1px solid var(--line2); font-family:'Space Mono',monospace; font-size:11px; font-weight:700; color:var(--acc2); display:flex; align-items:center; justify-content:center;">{i + 1}</span>
                <span>{s}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      {rd.note && (
        <p style="font-size:12.5px; color:var(--faint); margin:14px 0 0; font-style:italic;">{rd.note}</p>
      )}
    </section>

    <!-- EVENT — kartu bisa diklik → modal detail (sama seperti halaman Event) -->
    {
      gameEvents.length > 0 && (
        <section style="max-width:1280px; margin:0 auto; padding:28px 28px 8px;">
          <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:22px; color:var(--txt); margin:0 0 16px;">{tr("ev.title")} <span style="color:var(--faint); font-size:16px;">({gameEvents.length})</span></h2>
          <div data-ev-grid style="display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:16px;">
            {gameEvents.map((e) => <EventCard e={e} lang={lang} />)}
          </div>
          <nav data-ev-pager aria-label="Pagination" style="display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:7px; margin-top:26px;"></nav>
        </section>
      )
    }

  </main>
  {gameEvents.length > 0 && <EventModal lang={lang} />}
  <Footer lang={lang} updatedAt={codes.updatedAt} />
  <CopyScript />
  <CountdownScript lang={lang} />



  {gameEvents.length > 8 && (
    <script is:inline define:vars={{ EV_PAGE: 8 }}>
      (function () {
        const grid = document.querySelector("[data-ev-grid]");
        const pager = document.querySelector("[data-ev-pager]");
        if (!grid || !pager) return;
        const cards = Array.from(grid.querySelectorAll("[data-event]"));
        let page = 1;

        function pageList(cur, total) {
          const want = new Set([1, total, cur, cur - 1, cur + 1]);
          const arr = [...want].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
          const out = [];
          let prev = 0;
          for (const n of arr) { if (n - prev > 1) out.push("…"); out.push(n); prev = n; }
          return out;
        }
        function pbtn(label, opts) {
          const el = document.createElement("button");
          el.type = "button";
          el.textContent = label;
          el.disabled = !!opts.disabled;
          el.style.cssText =
            "cursor:pointer; font-family:'Space Mono',monospace; font-size:13px; font-weight:700; min-width:38px; height:38px; padding:0 11px; border-radius:10px; border:1px solid " +
            (opts.active ? "var(--acc)" : "var(--line2)") + "; background:" + (opts.active ? "var(--acc)" : "var(--surface)") +
            "; color:" + (opts.active ? "var(--ink)" : opts.disabled ? "var(--faint)" : "var(--txt)") + (opts.disabled ? "; opacity:0.5; cursor:default" : "") + ";";
          if (opts.onClick && !opts.disabled) el.addEventListener("click", opts.onClick);
          return el;
        }
        function render() {
          const total = Math.max(1, Math.ceil(cards.length / EV_PAGE));
          if (page > total) page = total;
          const start = (page - 1) * EV_PAGE;
          cards.forEach((c, i) => (c.style.display = i >= start && i < start + EV_PAGE ? "flex" : "none"));
          pager.innerHTML = "";
          if (total <= 1) return;
          const go = (n) => { page = n; render(); grid.scrollIntoView({ behavior: "smooth", block: "start" }); };
          pager.appendChild(pbtn("‹", { disabled: page === 1, onClick: () => go(page - 1) }));
          for (const n of pageList(page, total)) {
            if (n === "…") {
              const d = document.createElement("span");
              d.textContent = "…";
              d.style.cssText = "color:var(--faint); font-family:'Space Mono',monospace; padding:0 4px;";
              pager.appendChild(d);
            } else pager.appendChild(pbtn(String(n), { active: n === page, onClick: () => go(n) }));
          }
          pager.appendChild(pbtn("›", { disabled: page === total, onClick: () => go(page + 1) }));
        }
        render();
      })();
    </script>
  )}
</Base>
