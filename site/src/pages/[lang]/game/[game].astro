---
// Halaman per-game — fokus satu game: kode aktif + event berlangsung + tautan
// karakter. Di-generate untuk tiap game berkode × bahasa. Bagus untuk SEO
// ("genshin impact kode redeem"). Template untuk semua game.
import Base from "../../../layouts/Base.astro";
import Header from "../../../components/Header.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import Footer from "../../../components/Footer.astro";
import CodeCard from "../../../components/CodeCard.astro";
import CopyScript from "../../../components/CopyScript.astro";
import CountdownScript from "../../../components/CountdownScript.astro";
import ShareButton from "../../../components/ShareButton.astro";
import EventCard from "../../../components/EventCard.astro";
import EventModal from "../../../components/EventModal.astro";
import { LANGS, t } from "../../../lib/i18n.mjs";
import { route } from "../../../lib/routes.mjs";
import { redeemInfo } from "../../../lib/redeem.mjs";
import { monthYear } from "../../../lib/seo.mjs";
import { loadCodes } from "../../../lib/codes.mjs";
import { loadEvents } from "../../../lib/events.mjs";
import { loadCatalog } from "../../../lib/catalog.mjs";

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  const withCodes = catalog.games.filter((g) => g.hasCodes);
  // URL pakai SLUG keyword (SEO); id internal dibawa lewat props (gameMeta.id).
  return LANGS.flatMap((lang) => withCodes.map((g) => ({ params: { lang, game: g.slug }, props: { gameMeta: g } })));
}

const { lang, game } = Astro.params; // `game` = slug URL
const { gameMeta } = Astro.props;
const gid = gameMeta.id; // id internal untuk filter data (codes/events/redeem)
const tr = t(lang);
const id = lang === "id";

const [codes, events] = await Promise.all([loadCodes(), loadEvents(lang)]);
const gameCodes = codes.active.filter((c) => c.game === gid);
const gameEvents = events.events.filter((e) => e.game === gid);
// Arsip kode kedaluwarsa (disimpan sbg database, TANPA cap → forever). Dipaginasi
// 20/halaman di klien (mirror halaman Roblox).
const ARCH_PAGE = 20;
const gameArchive = codes.archive.filter((c) => c.game === gid);

// Cara redeem (spesifik per game, terverifikasi — lihat lib/redeem.mjs).
const rd = redeemInfo(gid, lang);

// FAQ per game — SEMUA jawaban BERSUMBER dari data redeem terverifikasi (rd) +
// fakta universal/tentang KodeGG. TIDAK ada trivia game yang dikarang.
const gname = gameMeta.name;
const faqs = [];
{
  let a = id ? `Di dalam game: ${rd.ingame.join(" → ")}.` : `In-game: ${rd.ingame.join(" → ")}.`;
  if (rd.web) a += id ? ` Bisa juga redeem online lewat halaman resmi (lihat bagian “Cara redeem” di atas).` : ` You can also redeem online on the official page (see the “How to redeem” section above).`;
  if (rd.note) a += ` ${rd.note}`;
  faqs.push({ q: id ? `Bagaimana cara redeem kode ${gname}?` : `How do I redeem ${gname} codes?`, a });
}
if (rd.req) {
  faqs.push({
    q: id ? `Apa syarat agar kode ${gname} bisa dipakai?` : `What do I need before ${gname} codes work?`,
    a: id ? `Syarat: ${rd.req}. Selama belum terpenuhi, kode belum bisa ditukar.` : `Requirement: ${rd.req}. Until you meet it, codes can't be redeemed.`,
  });
}
{
  const reasons = id
    ? "kodenya sudah kedaluwarsa, kamu sudah pernah menukarnya, atau ada salah ketik saat memasukkannya"
    : "the code has expired, you've already redeemed it, or there's a typo when entering it";
  const reqPart = rd.req ? (id ? `, atau syaratnya belum terpenuhi (${rd.req})` : `, or you haven't met the requirement (${rd.req})`) : "";
  faqs.push({
    q: id ? `Kenapa kode ${gname} tidak bisa dipakai?` : `Why isn't my ${gname} code working?`,
    a: id ? `Biasanya karena ${reasons}${reqPart}.` : `Usually because ${reasons}${reqPart}.`,
  });
}
faqs.push({
  q: id ? `Seberapa sering kode ${gname} diperbarui di KodeGG?` : `How often are ${gname} codes updated on KodeGG?`,
  a: id
    ? "Otomatis tiap jam dari sumber resmi & tepercaya. Kode kedaluwarsa tidak dihapus — diarsipkan jadi database."
    : "Automatically every hour from official and trusted sources. Expired codes aren't deleted — they're archived into a database.",
});

const my = monthYear(lang);
const meta = {
  title: id
    ? `Kode Redeem ${gameMeta.name} ${my} (Masih Aktif) — KodeGG`
    : `${gameMeta.name} Redeem Codes ${my} (Active) — KodeGG`,
  desc: id
    ? `Kode redeem ${gameMeta.name} terbaru ${my} yang masih aktif + event berlangsung. Diperbarui otomatis tiap jam.`
    : `Latest active ${gameMeta.name} redeem codes for ${my} plus live events. Auto-updated hourly.`,
};

const site = Astro.site.href.replace(/\/$/, "");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: id ? "Beranda" : "Home", item: `${site}/${lang}` },
      { "@type": "ListItem", position: 2, name: tr("nav.discover"), item: `${site}${route("discover", lang)}` },
      { "@type": "ListItem", position: 3, name: gameMeta.name },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoGame",
    name: gameMeta.name,
    url: `${site}/${lang}/game/${game}`,
    ...(codes.updatedAt ? { dateModified: codes.updatedAt } : {}),
    ...(gameMeta.cover ? { image: gameMeta.cover } : {}),
    ...(gameMeta.genreLabels?.length ? { genre: gameMeta.genreLabels } : {}),
    gamePlatform: ["Android", "iOS"],
    ...(gameMeta.rating && gameMeta.ratingCount
      ? {
          aggregateRating: {
            "@type": "AggregateRating",
            ratingValue: gameMeta.rating,
            ratingCount: gameMeta.ratingCount,
            bestRating: 5,
            worstRating: 1,
          },
        }
      : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: id ? `Cara redeem kode ${gameMeta.name}` : `How to redeem ${gameMeta.name} codes`,
    description: id
      ? `Langkah-langkah menukar kode redeem ${gameMeta.name} langsung di dalam game.`
      : `Step-by-step guide to redeem ${gameMeta.name} codes inside the game.`,
    step: rd.ingame.map((s, i) => ({ "@type": "HowToStep", position: i + 1, name: s, text: s })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base lang={lang} title={meta.title} description={meta.desc} paths={{ id: `/id/game/${game}`, en: `/en/game/${game}` }} jsonLd={jsonLd} ogImage={`/assets/og/games/${gid}.png`}>
  <Header lang={lang} active={null} paths={{ id: `/id/game/${game}`, en: `/en/game/${game}` }} />
  <Breadcrumb
    items={[
      { label: id ? "Beranda" : "Home", href: route("home", lang) },
      { label: tr("nav.discover"), href: route("discover", lang) },
      { label: gameMeta.name },
    ]}
  />
  <main id="main">
    <!-- HERO — baris atas: icon + aksi (favorit, bagikan); lalu judul full-width;
         lalu genre. (Rapi & konsisten dg halaman game Roblox.) -->
    <section style="max-width:1280px; margin:0 auto; padding:22px 28px 8px;">
      <div style="display:flex; align-items:center; gap:14px; margin-bottom:14px;">
        {gameMeta.cover && <img src={gameMeta.cover} alt={gameMeta.name} width="60" height="60" style="width:60px; height:60px; border-radius:15px; object-fit:cover; border:1px solid var(--line2); flex:0 0 auto;" onerror="this.style.display='none'" />}
        <div style="margin-left:auto; display:flex; align-items:center; gap:10px; flex:0 0 auto;">
          <button
            class="gg-fav"
            data-fav={gid}
            type="button"
            aria-pressed="false"
            aria-label={id ? "Simpan ke favorit" : "Save to favorites"}
            title={id ? "Simpan ke favorit" : "Save to favorites"}
            style="flex:none; width:40px; height:40px; border-radius:10px; border:1px solid var(--line2); background:var(--surface); color:var(--muted); cursor:pointer; display:flex; align-items:center; justify-content:center; padding:0;"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"></path></svg>
          </button>
          <ShareButton
            url={`${site}/${lang}/game/${game}`}
            text={id ? `Kode redeem ${gameMeta.name} terbaru — KodeGG` : `Latest ${gameMeta.name} redeem codes — KodeGG`}
            lang={lang}
          />
        </div>
      </div>
      <h1 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(28px,4.5vw,44px); letter-spacing:-0.02em; color:#fff; margin:0; line-height:1.1;">{id ? `Kode Redeem ${gameMeta.name}` : `${gameMeta.name} Redeem Codes`}</h1>
      {(gameMeta.genreLabels?.length || gameMeta.rating) && (
        <div style="font-family:'Space Mono',monospace; font-size:12px; color:var(--faint); margin-top:8px;">
          {gameMeta.genreLabels?.join(" · ")}{gameMeta.rating ? ` · ★ ${gameMeta.rating}` : ""}
        </div>
      )}
    </section>

    <!-- KODE -->
    <section style="max-width:1280px; margin:0 auto; padding:24px 28px 8px;">
      <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:16px; gap:12px;">
        <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:22px; color:var(--txt); margin:0;">
          {id ? "Kode aktif" : "Active codes"} <span style="color:var(--faint); font-size:16px;">({gameCodes.length})</span>
        </h2>
        <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
          {gameCodes.some((c) => c.code) && (
            <button
              data-copy-all
              data-codes={gameCodes.map((c) => c.code).filter(Boolean).join("\n")}
              data-label={id ? "Salin semua" : "Copy all"}
              data-done={id ? "Tersalin ✓" : "Copied ✓"}
              type="button"
              style="cursor:pointer; font-family:'Space Mono',monospace; font-size:12px; font-weight:700; border:1px solid var(--line2); color:var(--txt); background:var(--surface2); border-radius:9px; padding:8px 13px; white-space:nowrap; transition:all .15s;"
            >
              {id ? "Salin semua" : "Copy all"}
            </button>
          )}
          <a href={`${route("codes", lang)}?game=${game}`} style="font-family:'Space Mono',monospace; font-size:12px; font-weight:700; color:var(--acc); text-decoration:none; white-space:nowrap;">{id ? "Halaman kode" : "Codes page"} →</a>
        </div>
      </div>
      {
        gameCodes.length > 0 ? (
          <div data-code-grid style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr)); gap:18px;">
            {gameCodes.map((card) => <CodeCard card={card} lang={lang} linkGame={false} />)}
          </div>
        ) : (
          <p style="color:var(--muted); font-size:15px;">{id ? "Belum ada kode aktif saat ini." : "No active codes right now."}</p>
        )
      }
      <nav data-code-pager aria-label="Pagination" style="display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:7px; margin-top:26px;"></nav>
    </section>

    <!-- CARA REDEEM — spesifik per game (data terverifikasi di lib/redeem.mjs) -->
    <section style="max-width:1280px; margin:0 auto; padding:28px 28px 8px;">
      <div style="display:flex; align-items:baseline; gap:12px; flex-wrap:wrap; margin-bottom:6px;">
        <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:22px; color:var(--txt); margin:0;">
          {id ? `Cara redeem kode ${gameMeta.name}` : `How to redeem ${gameMeta.name} codes`}
        </h2>
        {rd.req && (
          <span style="font-family:'Space Mono',monospace; font-size:11.5px; font-weight:700; color:var(--warn); background:rgba(255,177,60,0.1); border:1px solid rgba(255,177,60,0.28); padding:5px 10px; border-radius:999px;">
            {id ? "Syarat" : "Requires"}: {rd.req}
          </span>
        )}
      </div>
      <p style="font-size:14px; color:var(--muted); margin:0 0 18px;">
        {id
          ? "Kode ditukar langsung di game (atau lewat web bila tersedia). Hadiah masuk ke in-game mail."
          : "Codes are redeemed in-game (or on the web where available). Rewards arrive in your in-game mail."}
      </p>

      <div style={`display:grid; grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr)); gap:16px; max-width:${rd.web ? "880px" : "560px"};`}>
        {rd.web && (
          <div style="background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:20px;">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:14px;">
              <span style="font-family:'Space Mono',monospace; font-size:11px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--acc);">{id ? "Lewat web" : "Via web"}</span>
              <a href={rd.web} target="_blank" rel="noopener nofollow" style="font-family:'Space Mono',monospace; font-size:11.5px; font-weight:700; color:var(--ink); background:var(--acc); padding:6px 12px; border-radius:9px; text-decoration:none;">{id ? "Buka halaman resmi ↗" : "Open official page ↗"}</a>
            </div>
            <ol style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:11px;">
              {rd.webSteps.map((s, i) => (
                <li style="display:flex; gap:11px; align-items:flex-start; font-size:14px; line-height:1.5; color:var(--txt);">
                  <span style="flex:none; width:22px; height:22px; border-radius:7px; background:var(--surface2); border:1px solid var(--line2); font-family:'Space Mono',monospace; font-size:11px; font-weight:700; color:var(--acc); display:flex; align-items:center; justify-content:center;">{i + 1}</span>
                  <span>{s}</span>
                </li>
              ))}
            </ol>
          </div>
        )}

        <div style="background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:20px;">
          <div style="margin-bottom:14px;">
            <span style="font-family:'Space Mono',monospace; font-size:11px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--acc2);">{id ? "Di dalam game" : "In-game"}</span>
          </div>
          <ol style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:11px;">
            {rd.ingame.map((s, i) => (
              <li style="display:flex; gap:11px; align-items:flex-start; font-size:14px; line-height:1.5; color:var(--txt);">
                <span style="flex:none; width:22px; height:22px; border-radius:7px; background:var(--surface2); border:1px solid var(--line2); font-family:'Space Mono',monospace; font-size:11px; font-weight:700; color:var(--acc2); display:flex; align-items:center; justify-content:center;">{i + 1}</span>
                <span>{s}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      {rd.note && (
        <p style="font-size:12.5px; color:var(--faint); margin:14px 0 0; font-style:italic;">{rd.note}</p>
      )}
    </section>

    <!-- EVENT — kartu bisa diklik → modal detail (sama seperti halaman Event) -->
    {
      gameEvents.length > 0 && (
        <section style="max-width:1280px; margin:0 auto; padding:28px 28px 8px;">
          <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:22px; color:var(--txt); margin:0 0 16px;">{tr("ev.title")} <span style="color:var(--faint); font-size:16px;">({gameEvents.length})</span></h2>
          <div data-ev-grid style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(280px,100%),1fr)); gap:16px;">
            {gameEvents.map((e) => <EventCard e={e} lang={lang} />)}
          </div>
          <nav data-ev-pager aria-label="Pagination" style="display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:7px; margin-top:26px;"></nav>
        </section>
      )
    }

    <!-- ARSIP KODE KEDALUWARSA — disimpan sbg database, tidak dihapus -->
    {
      gameArchive.length > 0 && (
        <section style="max-width:1280px; margin:0 auto; padding:28px 28px 8px;">
          <details>
            <summary style="cursor:pointer; display:flex; align-items:center; gap:10px; list-style:none;">
              <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:22px; color:var(--txt); margin:0;">
                {id ? "Arsip kode kedaluwarsa" : "Expired codes archive"} <span style="color:var(--faint); font-size:16px; font-weight:700;">({gameArchive.length})</span>
              </h2>
              <svg class="gg-arch-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--faint)" stroke-width="2.5" stroke-linecap="round" style="transition:transform .2s;">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <p style="color:var(--faint); font-size:13px; margin:12px 0 0; font-family:'Space Mono',monospace;">
              {id
                ? `${gameArchive.length} kode kedaluwarsa — disimpan sebagai database, tidak pernah dihapus.`
                : `${gameArchive.length} expired codes — kept as a database, never deleted.`}
            </p>
            <div data-arch-grid style="margin-top:16px; display:grid; grid-template-columns:repeat(auto-fill,minmax(min(240px,100%),1fr)); gap:12px;">
              {gameArchive.map((c) => (
                <div data-arch-card style="background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:13px; opacity:.72;">
                  <div style="font-size:12.5px; font-weight:700; color:var(--muted); margin-bottom:8px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{c.reward || (id ? "Kode kedaluwarsa" : "Expired code")}</div>
                  <code style="display:block; font-family:'Space Mono',monospace; font-size:12.5px; font-weight:700; color:var(--faint); background:var(--bg); border:1px dashed var(--line2); border-radius:8px; padding:7px 9px; text-align:center; overflow:hidden; text-overflow:ellipsis; text-decoration:line-through;">{c.code}</code>
                </div>
              ))}
            </div>
            <nav data-arch-pager aria-label="Pagination" style="display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:7px; margin-top:22px;" />
          </details>
        </section>
      )
    }

    <!-- FAQ — jawaban bersumber dari data redeem terverifikasi (lib/redeem.mjs) -->
    <section style="max-width:1280px; margin:0 auto; padding:36px 28px 12px;">
      <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:22px; color:var(--txt); margin:0 0 16px;">
        {id ? `Pertanyaan umum — ${gameMeta.name}` : `FAQ — ${gameMeta.name}`}
      </h2>
      <div style="display:flex; flex-direction:column; gap:10px; max-width:820px;">
        {
          faqs.map((f) => (
            <details style="background:var(--surface); border:1px solid var(--line); border-radius:14px;">
              <summary style="display:flex; align-items:center; justify-content:space-between; gap:12px; padding:15px 18px; cursor:pointer; font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:15px; color:var(--txt); list-style:none;">
                <span>{f.q}</span>
                <svg class="gg-arch-chev" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.4" stroke-linecap="round" style="flex:0 0 auto; transition:transform .2s;"><path d="M6 9l6 6 6-6" /></svg>
              </summary>
              <div style="padding:0 18px 16px; font-size:14px; line-height:1.65; color:var(--muted);">{f.a}</div>
            </details>
          ))
        }
      </div>
    </section>

  </main>
  {gameEvents.length > 0 && <EventModal lang={lang} />}
  <Footer lang={lang} updatedAt={codes.updatedAt} />
  <CopyScript />
  <CountdownScript lang={lang} />



  {gameEvents.length > 8 && (
    <script is:inline define:vars={{ EV_PAGE: 8 }}>
      (function () {
        const grid = document.querySelector("[data-ev-grid]");
        const pager = document.querySelector("[data-ev-pager]");
        if (!grid || !pager) return;
        const cards = Array.from(grid.querySelectorAll("[data-event]"));
        let page = 1;

        function pageList(cur, total) {
          const want = new Set([1, total, cur, cur - 1, cur + 1]);
          const arr = [...want].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
          const out = [];
          let prev = 0;
          for (const n of arr) { if (n - prev > 1) out.push("…"); out.push(n); prev = n; }
          return out;
        }
        function pbtn(label, opts) {
          const el = document.createElement("button");
          el.type = "button";
          el.textContent = label;
          el.disabled = !!opts.disabled;
          el.style.cssText =
            "cursor:pointer; font-family:'Space Mono',monospace; font-size:13px; font-weight:700; min-width:38px; height:38px; padding:0 11px; border-radius:10px; border:1px solid " +
            (opts.active ? "var(--acc)" : "var(--line2)") + "; background:" + (opts.active ? "var(--acc)" : "var(--surface)") +
            "; color:" + (opts.active ? "var(--ink)" : opts.disabled ? "var(--faint)" : "var(--txt)") + (opts.disabled ? "; opacity:0.5; cursor:default" : "") + ";";
          if (opts.onClick && !opts.disabled) el.addEventListener("click", opts.onClick);
          return el;
        }
        function render() {
          const total = Math.max(1, Math.ceil(cards.length / EV_PAGE));
          if (page > total) page = total;
          const start = (page - 1) * EV_PAGE;
          cards.forEach((c, i) => (c.style.display = i >= start && i < start + EV_PAGE ? "flex" : "none"));
          pager.innerHTML = "";
          if (total <= 1) return;
          const go = (n) => { page = n; render(); grid.scrollIntoView({ behavior: "smooth", block: "start" }); };
          pager.appendChild(pbtn("‹", { disabled: page === 1, onClick: () => go(page - 1) }));
          for (const n of pageList(page, total)) {
            if (n === "…") {
              const d = document.createElement("span");
              d.textContent = "…";
              d.style.cssText = "color:var(--faint); font-family:'Space Mono',monospace; padding:0 4px;";
              pager.appendChild(d);
            } else pager.appendChild(pbtn(String(n), { active: n === page, onClick: () => go(n) }));
          }
          pager.appendChild(pbtn("›", { disabled: page === total, onClick: () => go(page + 1) }));
        }
        render();
      })();
    </script>
  )}

  {gameCodes.length > 8 && (
    <script is:inline define:vars={{ CODE_PAGE: 8 }}>
      (function () {
        const grid = document.querySelector("[data-code-grid]");
        const pager = document.querySelector("[data-code-pager]");
        if (!grid || !pager) return;
        const cards = Array.from(grid.querySelectorAll("[data-code-card]"));
        let page = 1;

        function pageList(cur, total) {
          const want = new Set([1, total, cur, cur - 1, cur + 1]);
          const arr = [...want].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
          const out = [];
          let prev = 0;
          for (const n of arr) { if (n - prev > 1) out.push("…"); out.push(n); prev = n; }
          return out;
        }
        function pbtn(label, opts) {
          const el = document.createElement("button");
          el.type = "button";
          el.textContent = label;
          el.disabled = !!opts.disabled;
          el.style.cssText =
            "cursor:pointer; font-family:'Space Mono',monospace; font-size:13px; font-weight:700; min-width:38px; height:38px; padding:0 11px; border-radius:10px; border:1px solid " +
            (opts.active ? "var(--acc)" : "var(--line2)") + "; background:" + (opts.active ? "var(--acc)" : "var(--surface)") +
            "; color:" + (opts.active ? "var(--ink)" : opts.disabled ? "var(--faint)" : "var(--txt)") + (opts.disabled ? "; opacity:0.5; cursor:default" : "") + ";";
          if (opts.onClick && !opts.disabled) el.addEventListener("click", opts.onClick);
          return el;
        }
        function render() {
          const total = Math.max(1, Math.ceil(cards.length / CODE_PAGE));
          if (page > total) page = total;
          const start = (page - 1) * CODE_PAGE;
          cards.forEach((c, i) => (c.style.display = i >= start && i < start + CODE_PAGE ? "flex" : "none"));
          pager.innerHTML = "";
          if (total <= 1) return;
          const go = (n) => { page = n; render(); grid.scrollIntoView({ behavior: "smooth", block: "start" }); };
          pager.appendChild(pbtn("‹", { disabled: page === 1, onClick: () => go(page - 1) }));
          for (const n of pageList(page, total)) {
            if (n === "…") {
              const d = document.createElement("span");
              d.textContent = "…";
              d.style.cssText = "color:var(--faint); font-family:'Space Mono',monospace; padding:0 4px;";
              pager.appendChild(d);
            } else pager.appendChild(pbtn(String(n), { active: n === page, onClick: () => go(n) }));
          }
          pager.appendChild(pbtn("›", { disabled: page === total, onClick: () => go(page + 1) }));
        }
        render();
      })();
    </script>
  )}

  <!-- Favorit game (localStorage kodegg:fav) — sinkron dg Jelajah/Beranda/Saved. -->
  <script is:inline>
    (function () {
      const KEY = "kodegg:fav";
      let favs = [];
      try { favs = JSON.parse(localStorage.getItem(KEY) || "[]"); } catch {}
      const set = new Set(favs);
      const paint = (btn, on) => {
        btn.style.color = on ? "var(--acc)" : "var(--muted)";
        btn.style.borderColor = on ? "var(--acc)" : "var(--line2)";
        btn.setAttribute("aria-pressed", String(on));
        btn.querySelector("svg").setAttribute("fill", on ? "var(--acc)" : "none");
      };
      for (const btn of document.querySelectorAll("[data-fav]")) {
        if (set.has(btn.dataset.fav)) paint(btn, true);
        btn.addEventListener("click", () => {
          const fid = btn.dataset.fav;
          if (set.has(fid)) set.delete(fid);
          else set.add(fid);
          localStorage.setItem(KEY, JSON.stringify([...set]));
          window.dispatchEvent(new Event("kodegg:fav"));
          paint(btn, set.has(fid));
        });
      }
    })();
  </script>

