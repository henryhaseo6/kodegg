---
// Route TERPADU untuk semua halaman statis (selain beranda & per-game). Slug
// per bahasa dari lib/routes.mjs → /id/jelajah, /en/discover, dst. Tiap slug
// dipetakan ke komponen + data + meta-nya.
import Base from "../../layouts/Base.astro";
import CatalogPage from "../../components/CatalogPage.astro";
import RedeemPage from "../../components/RedeemPage.astro";
import FeedPage from "../../components/FeedPage.astro";
import FavoritPage from "../../components/FavoritPage.astro";
import TentangPage from "../../components/TentangPage.astro";
import KontakPage from "../../components/KontakPage.astro";
import PrivasiPage from "../../components/PrivasiPage.astro";
import KetentuanPage from "../../components/KetentuanPage.astro";
import { LANGS, t } from "../../lib/i18n.mjs";
import { SLUGS, PAGE_KEYS, langPaths, route } from "../../lib/routes.mjs";
import { loadCatalog } from "../../lib/catalog.mjs";
import { loadRobloxSavedCards } from "../../lib/roblox.mjs";
import { loadCodes } from "../../lib/codes.mjs";
import { loadFeed } from "../../lib/feed.mjs";
import { monthYear } from "../../lib/seo.mjs";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    PAGE_KEYS.map((key) => ({ params: { lang, page: SLUGS[key][lang] }, props: { key } })),
  );
}

const { lang } = Astro.params;
const { key } = Astro.props;
const tr = t(lang);
const id = lang === "id";

let Comp;
let data = null;
let title;
let desc;
if (key === "discover") {
  Comp = CatalogPage;
  data = await loadCatalog();
  title = tr("cat.metaTitle");
  desc = tr("cat.metaDesc");
} else if (key === "codes") {
  Comp = RedeemPage;
  data = await loadCodes();
  const my = monthYear(lang);
  title = id
    ? `Kode Redeem Game Online ${my} (Terbaru) — KodeGG`
    : `Latest Online Game Redeem Codes ${my} — KodeGG`;
  desc = id
    ? `Kumpulan kode redeem aktif ${my}: Genshin Impact, Honkai: Star Rail, Zenless Zone Zero, dan lainnya. Diperbarui otomatis tiap jam + arsip kode kadaluarsa.`
    : `Active redeem codes for ${my}: Genshin Impact, Honkai: Star Rail, Zenless Zone Zero, and more. Auto-updated hourly, with an archive of expired codes.`;
} else if (key === "news") {
  Comp = FeedPage;
  data = await loadFeed(lang);
  title = tr("feed.metaTitle");
  desc = tr("feed.metaDesc");
} else if (key === "saved") {
  Comp = FavoritPage;
  // Favorit lintas-vertikal: gabung game mobile + Roblox agar keduanya bisa
  // tampil di /saved (favorit disimpan di localStorage yang sama).
  const [cat, rbx] = await Promise.all([loadCatalog(), loadRobloxSavedCards()]);
  data = { ...cat, games: [...cat.games, ...rbx] };
  title = tr("fav.metaTitle");
  desc = tr("fav.metaDesc");
} else if (key === "about") {
  Comp = TentangPage;
  title = id ? "Tentang KodeGG — Portal Info Game Online" : "About KodeGG — Online Game Info Portal";
  desc = id
    ? "Apa itu KodeGG, dari mana datanya, dan komitmen kami: bersih dari judi online."
    : "What KodeGG is, where the data comes from, and our commitment: free of online gambling.";
} else if (key === "privacy") {
  Comp = PrivasiPage;
  title = id ? "Kebijakan Privasi — KodeGG" : "Privacy Policy — KodeGG";
  desc = id
    ? "Kebijakan privasi KodeGG: data notifikasi push yang disimpan, penyimpanan lokal, dan komitmen tanpa pelacakan."
    : "KodeGG privacy policy: what push-notification data we store, local storage, and our no-tracking commitment.";
} else if (key === "terms") {
  Comp = KetentuanPage;
  title = id ? "Ketentuan Layanan — KodeGG" : "Terms of Service — KodeGG";
  desc = id
    ? "Ketentuan layanan KodeGG: sifat informasi kode redeem, batas tanggung jawab, dan status non-afiliasi dengan penerbit game."
    : "KodeGG terms of service: the nature of redeem-code information, limits of liability, and our non-affiliation with game publishers.";
} else {
  Comp = KontakPage;
  title = id ? "Kontak — KodeGG" : "Contact — KodeGG";
  desc = id
    ? "Hubungi KodeGG: lapor kode kedaluwarsa, usul game, atau kerja sama."
    : "Get in touch with KodeGG: report expired codes, suggest games, or partnerships.";
}
// Structured data. Semua halaman konten dapat BreadcrumbList; halaman Kode
// (halaman terpenting) juga dapat HowTo (cara redeem) + ItemList kode aktif.
const site = Astro.site.href.replace(/\/$/, "");
const crumbName =
  { discover: tr("nav.discover"), codes: tr("nav.codes"), news: tr("nav.news"), about: id ? "Tentang" : "About", contact: id ? "Kontak" : "Contact", privacy: id ? "Privasi" : "Privacy", terms: id ? "Ketentuan" : "Terms", saved: tr("nav.saved") }[key] ?? title;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: id ? "Beranda" : "Home", item: `${site}/${lang}/` },
      { "@type": "ListItem", position: 2, name: crumbName, item: `${site}${route(key, lang)}` },
    ],
  },
];
if (key === "codes") {
  jsonLd.push(
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      name: tr("how.title"),
      step: [tr("how.step1"), tr("how.step2"), tr("how.step3")].map((s, i) => ({ "@type": "HowToStep", position: i + 1, name: s, text: s })),
    },
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: title,
      numberOfItems: data.active.length,
      itemListElement: data.active
        .filter((c) => c.code)
        .slice(0, 60)
        .map((c, i) => ({ "@type": "ListItem", position: i + 1, name: `${c.name}: ${c.code}`, url: `${site}/${lang}/game/${c.gameSlug}/` })),
    },
  );
}
---

<Base lang={lang} title={title} description={desc} paths={langPaths(key)} noindex={key === "saved"} jsonLd={jsonLd}>
  <Comp lang={lang} data={data} />
</Base>
