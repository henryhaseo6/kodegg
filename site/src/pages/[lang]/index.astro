---
import Base from "../../layouts/Base.astro";
import HomePage from "../../components/HomePage.astro";
import { LANGS, t } from "../../lib/i18n.mjs";
import { loadCodes } from "../../lib/codes.mjs";
import { loadFeed } from "../../lib/feed.mjs";
import { loadCatalog } from "../../lib/catalog.mjs";
import { loadRobloxHome } from "../../lib/roblox.mjs";
import { langPaths, route } from "../../lib/routes.mjs";
import { monthYear } from "../../lib/seo.mjs";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const tr = t(lang);
const [codes, feed, catalog, roblox] = await Promise.all([loadCodes(), loadFeed(lang), loadCatalog(), loadRobloxHome(8)]);

const my = monthYear(lang);
const meta = lang === "id"
  ? { title: "KodeGG — Kode Redeem Game Online & Roblox: Event, Berita", desc: `Kode redeem terbaru ${my} untuk game online & Roblox, event & banner, dan berita — otomatis, diperbarui tiap jam. Genshin, Star Rail, Zenless, Blox Fruits, dan lainnya.` }
  : { title: "KodeGG — Online Game & Roblox Redeem Codes: Events, News", desc: `Latest ${my} redeem codes for online games & Roblox, events & banners, and news — automated, updated hourly. Genshin, Star Rail, Zenless, Blox Fruits, and more.` };

const site = Astro.site.href.replace(/\/$/, "");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "KodeGG",
    alternateName: "KodeGG — Portal Info Game Online",
    url: `${site}/${lang}/`,
    inLanguage: lang === "id" ? "id-ID" : "en-US",
    description: meta.desc,
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: `${site}${route("codes", lang)}?q={search_term_string}`,
      },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "KodeGG",
    url: `${site}/`,
    logo: `${site}/assets/favicon-512.png`,
  },
];
---

<Base lang={lang} title={meta.title} description={meta.desc} paths={langPaths("home")} jsonLd={jsonLd}>
  <HomePage lang={lang} codes={codes} catalog={catalog} feed={feed} roblox={roblox} />
</Base>
