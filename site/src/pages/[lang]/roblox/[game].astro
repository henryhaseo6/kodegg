---
// Halaman kode Roblox per-game: /{lang}/roblox/{slug}. Sumber: RoCodes.gg.
import Base from "../../../layouts/Base.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import CodeCard from "../../../components/CodeCard.astro";
import CopyScript from "../../../components/CopyScript.astro";
import CountdownScript from "../../../components/CountdownScript.astro";
import ShareButton from "../../../components/ShareButton.astro";
import { LANGS } from "../../../lib/i18n.mjs";
import { loadRobloxCatalog, loadRobloxGame } from "../../../lib/roblox.mjs";
import { robloxGamePaths, robloxHome } from "../../../lib/routes.mjs";
import { monthYear } from "../../../lib/seo.mjs";

export async function getStaticPaths() {
  const games = await loadRobloxCatalog();
  return LANGS.flatMap((lang) => games.map((g) => ({ params: { lang, game: g.slug }, props: { slug: g.slug } })));
}

const { lang, game: slug } = Astro.params;
const id = lang === "id";
const g = await loadRobloxGame(slug);
if (!g) return Astro.redirect(`/${lang}/roblox`);

const my = monthYear(lang);
const ARCH_CAP = 24; // Fase 1: tampilkan arsip terbaru saja (windowing di Fase 3)
const archShown = g.archive.slice(0, ARCH_CAP);

// Cara redeem Roblox: BILINGUAL & standar. howTo dari RoCodes cuma Inggris +
// mengandung placeholder {{game_name}} yang tak tersubstitusi, jadi tak dipakai.
// Redemption Roblox sangat seragam (tombol Codes → masukkan → Redeem), jadi
// langkah standar ini akurat untuk hampir semua game. (Spesifik per-game =
// perbaikan Fase 3 bila sumber menyediakan langkah bersih & terlokalisasi.)
const redeemStd = {
  id: [
    "Buka game-nya di Roblox",
    "Cari tombol Codes — biasanya di layar utama, atau lewat ikon Twitter/burung atau menu Settings",
    "Tempel kode dari daftar di atas (case-sensitive — salin persis)",
    "Tekan Redeem — hadiah langsung masuk",
  ],
  en: [
    "Open the game in Roblox",
    "Find the Codes button — usually on the main screen, or via a Twitter/bird icon or the Settings menu",
    "Paste a code from the list above (case-sensitive — copy exactly)",
    "Press Redeem — the reward is granted instantly",
  ],
};
// Cara redeem SPESIFIK per-game dari RoCodes bila ada (mis. Island of Move
// "walk over to the NPC…") — lebih akurat dari langkah standar. Kosong → standar
// bilingual. (howTo sumber berbahasa Inggris; dipakai apa adanya utk akurasi.)
const isSpecific = Array.isArray(g.howTo) && g.howTo.length >= 3;
const redeemSteps = { id: isSpecific ? g.howTo : redeemStd.id, en: isSpecific ? g.howTo : redeemStd.en };

const gname = g.name;
// Pemain konkuren → ringkas (jangan pakai regex literal di frontmatter .astro).
function fmtPlayers(n) {
  if (n >= 1e6) {
    const m = (n / 1e6).toFixed(1);
    return (m.endsWith(".0") ? m.slice(0, -2) : m) + "M";
  }
  if (n >= 1e3) return Math.round(n / 1e3) + "K";
  return String(n);
}

// FAQ per game — jawaban BERSUMBER dari fakta nyata (data kode, cara redeem
// standar Roblox, cara kerja KodeGG), bukan trivia game yang dikarang.
const faqs = [
  {
    q: id ? `Bagaimana cara redeem kode ${gname}?` : `How do I redeem ${gname} codes?`,
    a: (id ? "Di dalam game: " : "In-game: ") + redeemSteps[lang].join(" → ") + ". " +
      (id ? "Kode Roblox umumnya case-sensitive — salin persis." : "Roblox codes are usually case-sensitive — copy exactly."),
  },
  {
    q: id ? `Ada berapa kode ${gname} yang aktif sekarang?` : `How many ${gname} codes are active now?`,
    a: id
      ? `Saat ini ada ${g.active.length} kode aktif${g.verifiedCount ? ` (${g.verifiedCount} terverifikasi lewat cross-check)` : ""} dan ${g.archive.length} kode di arsip. Diperbarui otomatis tiap jam.`
      : `There are ${g.active.length} active codes${g.verifiedCount ? ` (${g.verifiedCount} cross-check verified)` : ""} and ${g.archive.length} archived right now. Updated automatically every hour.`,
  },
  {
    q: id ? `Kenapa kode ${gname} tidak bisa dipakai?` : `Why isn't my ${gname} code working?`,
    a: id
      ? "Biasanya karena kodenya sudah kedaluwarsa, kamu sudah pernah menukarnya, atau ada salah ketik/kapitalisasi (kode Roblox case-sensitive)."
      : "Usually because the code has expired, you've already redeemed it, or there's a typo/wrong capitalization (Roblox codes are case-sensitive).",
  },
  {
    q: id ? `Seberapa sering kode ${gname} diperbarui di KodeGG?` : `How often are ${gname} codes updated on KodeGG?`,
    a: id
      ? "Otomatis tiap jam dari RoCodes.gg, lalu di-cross-check dengan situs editorial besar (Pocket Tactics, Try Hard Guides, dll). Kode kedaluwarsa diarsipkan, tidak dihapus."
      : "Automatically every hour from RoCodes.gg, then cross-checked with major editorial sites (Pocket Tactics, Try Hard Guides, etc.). Expired codes are archived, not deleted.",
  },
];
if (g.players > 0) {
  faqs.push({
    q: id ? `Berapa pemain ${gname} saat ini?` : `How many people play ${gname} right now?`,
    a: id
      ? `Sekitar ${fmtPlayers(g.players)} pemain konkuren, dari data resmi Roblox (diperbarui tiap jam).`
      : `Around ${fmtPlayers(g.players)} concurrent players, from official Roblox data (updated hourly).`,
  });
}

const meta = id
  ? {
      title: `Kode Roblox ${g.name} ${my} — Terbaru & Aktif | KodeGG`,
      desc: `Semua kode ${g.name} (Roblox) yang aktif ${my} + arsip. ${g.active.length} kode aktif, diperbarui otomatis dari RoCodes.`,
    }
  : {
      title: `${g.name} Codes ${my} — Latest Roblox Codes | KodeGG`,
      desc: `All active ${g.name} (Roblox) codes for ${my} + archive. ${g.active.length} active codes, auto-updated from RoCodes.`,
    };

const site = Astro.site.href.replace(/\/$/, "");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "KodeGG", item: `${site}/${lang}` },
      { "@type": "ListItem", position: 2, name: "Roblox", item: `${site}${robloxHome(lang)}` },
      { "@type": "ListItem", position: 3, name: g.name, item: `${site}/${lang}/roblox/${slug}` },
    ],
  },
];
jsonLd.push({
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: id ? `Cara redeem kode ${g.name}` : `How to redeem ${g.name} codes`,
  step: redeemSteps[lang].map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })),
});
jsonLd.push({
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: gname,
  url: `${site}/${lang}/roblox/${slug}`,
  image: `${site}${g.icon}`,
  gamePlatform: "Roblox",
  ...(g.updatedAt ? { dateModified: g.updatedAt } : {}),
  ...(g.genres.length ? { genre: g.genres } : {}),
  publisher: { "@type": "Organization", name: "Roblox" },
});
jsonLd.push({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
});

const SectionHead = "font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:22px; letter-spacing:-0.02em; color:#fff; margin:0;";
---

<Base lang={lang} title={meta.title} description={meta.desc} paths={robloxGamePaths(slug)} jsonLd={jsonLd}>
  <Header lang={lang} active={null} paths={robloxGamePaths(slug)} />

  <Breadcrumb
    items={[
      { label: "KodeGG", href: `/${lang}` },
      { label: "Roblox", href: robloxHome(lang) },
      { label: g.name },
    ]}
  />

  <main id="main" style="max-width:1280px; margin:0 auto; padding:22px 28px 60px;">
    <!-- HERO -->
    <header style="display:flex; align-items:center; gap:16px; margin-bottom:8px;">
      <span style="width:66px; height:66px; border-radius:16px; overflow:hidden; flex:0 0 auto; background:var(--surface2); border:1px solid var(--line2); display:block;">
        <img src={g.icon} alt={g.name} width="66" height="66" style="width:100%;height:100%;object-fit:cover;display:block;"
          onerror="this.style.display='none';this.parentElement.style.background='linear-gradient(135deg,var(--surface2),var(--bg2))';" />
      </span>
      <div style="min-width:0;">
        <div style="display:flex; align-items:center; gap:9px; flex-wrap:wrap;">
          <span style="font-family:'Space Mono',monospace; font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:var(--acc2); border:1px solid rgba(139,107,255,0.5); background:rgba(139,107,255,0.1); padding:3px 8px; border-radius:6px;">Roblox</span>
          {g.verifiedCount > 0 && (
            <span style="display:inline-flex; align-items:center; gap:5px; font-family:'Space Mono',monospace; font-size:11px; font-weight:700; color:var(--ok); background:rgba(55,227,139,0.12); border:1px solid rgba(55,227,139,0.35); padding:3px 8px; border-radius:6px;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
              {g.verifiedCount} {id ? "terverifikasi" : "verified"}
            </span>
          )}
          {g.players > 0 && (
            <span style="display:inline-flex; align-items:center; gap:5px; font-family:'Space Mono',monospace; font-size:11px; font-weight:700; color:var(--muted); background:var(--surface); border:1px solid var(--line2); padding:3px 8px; border-radius:6px;" title={id ? "Pemain konkuren (data resmi Roblox, tiap jam)" : "Concurrent players (official Roblox data, hourly)"}>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="3.2"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M17 11a3 3 0 0 0 0-6M21.5 20a6.5 6.5 0 0 0-5-6.3"/></svg>
              {fmtPlayers(g.players)} {id ? "pemain" : "players"}
            </span>
          )}
        </div>
        <h1 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(24px,4vw,36px); letter-spacing:-0.02em; color:#fff; margin:6px 0 0; line-height:1.1;">
          {id ? `Kode ${g.name}` : `${g.name} Codes`}
        </h1>
      </div>
      <div style="margin-left:auto;">
        <ShareButton
          url={`${site}/${lang}/roblox/${slug}`}
          text={id ? `Kode ${g.name} (Roblox) terbaru — KodeGG` : `Latest ${g.name} (Roblox) codes — KodeGG`}
          lang={lang}
        />
      </div>
    </header>
    <p style="color:var(--muted); font-size:15px; margin:0 0 26px;">
      {id
        ? `${g.active.length} kode aktif · ${g.archive.length} di arsip · ditarik otomatis dari RoCodes.gg`
        : `${g.active.length} active codes · ${g.archive.length} archived · auto-pulled from RoCodes.gg`}
      {g.crossCheck.length > 0 && (
        <span style="color:var(--faint);"> · {id ? "cross-check" : "cross-checked with"} {g.crossCheck.join(", ")}</span>
      )}
    </p>

    <!-- KODE AKTIF -->
    <section style="margin-bottom:38px;">
      <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:16px; gap:12px; flex-wrap:wrap;">
        <h2 style={SectionHead}>{id ? "Kode aktif" : "Active codes"} <span style="color:var(--faint); font-size:16px; font-weight:700;">({g.active.length})</span></h2>
        <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
          {g.active.some((c) => c.code) && (
            <button
              data-copy-all
              data-codes={g.active.map((c) => c.code).filter(Boolean).join("\n")}
              data-label={id ? "Salin semua" : "Copy all"}
              data-done={id ? "Tersalin ✓" : "Copied ✓"}
              type="button"
              style="cursor:pointer; font-family:'Space Mono',monospace; font-size:12px; font-weight:700; border:1px solid rgba(139,107,255,0.4); color:var(--acc2); background:var(--surface2); border-radius:9px; padding:8px 13px; white-space:nowrap; transition:all .15s;"
            >
              {id ? "Salin semua" : "Copy all"}
            </button>
          )}
          <a href={robloxHome(lang)} style="font-family:'Space Mono',monospace; font-size:12px; font-weight:700; color:var(--acc2); text-decoration:none; white-space:nowrap;">{id ? "Semua game Roblox" : "All Roblox games"} →</a>
        </div>
      </div>
      {g.verifiedCount > 0 && (
        <p style="font-size:12.5px; color:var(--faint); margin:0 0 16px; display:inline-flex; align-items:center; gap:7px; flex-wrap:wrap;">
          <span style="display:inline-flex; align-items:center; gap:4px; font-family:'Space Mono',monospace; font-size:10px; font-weight:700; color:var(--ink); background:var(--ok); padding:3px 7px; border-radius:6px;">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>Verified
          </span>
          {id ? "= kode juga dikonfirmasi aktif oleh situs editorial (cross-check)." : "= code also confirmed active by an editorial site (cross-check)."}
        </p>
      )}
      {g.active.length > 0 ? (
        <div data-code-grid style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr)); gap:16px;">
          {g.active.map((c) => <CodeCard card={c} lang={lang} linkGame={false} accent="var(--acc2)" gameBase="roblox" />)}
        </div>
      ) : (
        <p style="color:var(--muted); font-size:15px;">{id ? "Belum ada kode aktif saat ini. Cek arsip di bawah." : "No active codes right now. Check the archive below."}</p>
      )}
      <nav data-code-pager aria-label="Pagination" style="display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:7px; margin-top:26px;"></nav>
    </section>

    <!-- CARA REDEEM -->
    <section style="margin-bottom:38px;">
      <h2 style={SectionHead}>{id ? `Cara redeem kode ${g.name}` : `How to redeem ${g.name} codes`}</h2>
      <div style="margin-top:16px; background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:22px; max-width:640px;">
        <ol style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:12px;">
          {redeemSteps[lang].map((s, i) => (
            <li style="display:flex; gap:12px; align-items:flex-start; font-size:14.5px; line-height:1.55; color:var(--txt);">
              <span style="flex:none; width:24px; height:24px; border-radius:8px; background:var(--surface2); border:1px solid rgba(139,107,255,0.4); font-family:'Space Mono',monospace; font-size:12px; font-weight:700; color:var(--acc2); display:flex; align-items:center; justify-content:center;">{i + 1}</span>
              <span>{s}</span>
            </li>
          ))}
        </ol>
        <p style="margin:16px 0 0; font-size:12.5px; color:var(--faint); font-family:'Space Mono',monospace;">
          {id ? "Kode Roblox umumnya case-sensitive — salin persis." : "Roblox codes are usually case-sensitive — copy exactly."}
        </p>
      </div>
    </section>

    <!-- ARSIP -->
    {g.archive.length > 0 && (
      <section>
        <details>
          <summary style="cursor:pointer; display:flex; align-items:center; gap:10px; list-style:none;">
            <h2 style={SectionHead}>{id ? "Arsip kode kedaluwarsa" : "Expired codes archive"} <span style="color:var(--faint); font-size:16px; font-weight:700;">({g.archive.length})</span></h2>
            <svg class="gg-arch-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--faint)" stroke-width="2.5" stroke-linecap="round" style="transition:transform .2s;"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <p style="color:var(--faint); font-size:13px; margin:12px 0 0; font-family:'Space Mono',monospace;">
            {id ? `Menampilkan ${archShown.length} terbaru dari ${g.archive.length}. Kode kedaluwarsa disimpan sebagai database, tidak dihapus.` : `Showing latest ${archShown.length} of ${g.archive.length}. Expired codes are kept as a database, never deleted.`}
          </p>
          <div style="margin-top:16px; display:grid; grid-template-columns:repeat(auto-fill,minmax(min(240px,100%),1fr)); gap:12px;">
            {archShown.map((c) => (
              <div style="background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:13px; opacity:.72;">
                <div style="font-size:12.5px; font-weight:700; color:var(--muted); margin-bottom:8px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{c.reward || (id ? "Kode kedaluwarsa" : "Expired code")}</div>
                <code style="display:block; font-family:'Space Mono',monospace; font-size:12.5px; font-weight:700; color:var(--faint); background:var(--bg); border:1px dashed var(--line2); border-radius:8px; padding:7px 9px; text-align:center; overflow:hidden; text-overflow:ellipsis; text-decoration:line-through;">{c.code}</code>
              </div>
            ))}
          </div>
        </details>
      </section>
    )}

    <!-- FAQ — jawaban dari data nyata (kode, cara redeem, cara kerja KodeGG) -->
    <section style="margin-top:44px;">
      <h2 style={SectionHead}>{id ? `Pertanyaan umum — ${g.name}` : `FAQ — ${g.name}`}</h2>
      <div style="margin-top:16px; display:flex; flex-direction:column; gap:10px; max-width:820px;">
        {faqs.map((f) => (
          <details style="background:var(--surface); border:1px solid var(--line); border-radius:14px;">
            <summary style="display:flex; align-items:center; justify-content:space-between; gap:12px; padding:15px 18px; cursor:pointer; font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:15px; color:var(--txt); list-style:none;">
              <span>{f.q}</span>
              <svg class="gg-arch-chev" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.4" stroke-linecap="round" style="flex:0 0 auto; transition:transform .2s;"><path d="M6 9l6 6 6-6" /></svg>
            </summary>
            <div style="padding:0 18px 16px; font-size:14px; line-height:1.65; color:var(--muted);">{f.a}</div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer lang={lang} updatedAt={g.updatedAt} />
  <CopyScript />
  <CountdownScript lang={lang} />

  {g.active.length > 8 && (
    <script is:inline define:vars={{ CODE_PAGE: 8 }}>
      (function () {
        const grid = document.querySelector("[data-code-grid]");
        const pager = document.querySelector("[data-code-pager]");
        if (!grid || !pager) return;
        const cards = Array.from(grid.querySelectorAll("[data-code-card]"));
        let page = 1;
        function pageList(cur, total) {
          const want = new Set([1, total, cur, cur - 1, cur + 1]);
          const arr = [...want].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
          const out = []; let prev = 0;
          for (const n of arr) { if (n - prev > 1) out.push("…"); out.push(n); prev = n; }
          return out;
        }
        function pbtn(label, opts) {
          const el = document.createElement("button");
          el.type = "button"; el.textContent = label; el.disabled = !!opts.disabled;
          el.style.cssText =
            "cursor:pointer; font-family:'Space Mono',monospace; font-size:13px; font-weight:700; min-width:38px; height:38px; padding:0 11px; border-radius:10px; border:1px solid " +
            (opts.active ? "var(--acc2)" : "var(--line2)") + "; background:" + (opts.active ? "var(--acc2)" : "var(--surface)") +
            "; color:" + (opts.active ? "#fff" : opts.disabled ? "var(--faint)" : "var(--txt)") + (opts.disabled ? "; opacity:0.5; cursor:default" : "") + ";";
          if (opts.onClick && !opts.disabled) el.addEventListener("click", opts.onClick);
          return el;
        }
        function render() {
          const total = Math.max(1, Math.ceil(cards.length / CODE_PAGE));
          if (page > total) page = total;
          const start = (page - 1) * CODE_PAGE;
          cards.forEach((c, i) => (c.style.display = i >= start && i < start + CODE_PAGE ? "flex" : "none"));
          pager.innerHTML = "";
          if (total <= 1) return;
          const go = (n) => { page = n; render(); grid.scrollIntoView({ behavior: "smooth", block: "start" }); };
          pager.appendChild(pbtn("‹", { disabled: page === 1, onClick: () => go(page - 1) }));
          for (const n of pageList(page, total)) {
            if (n === "…") {
              const d = document.createElement("span");
              d.textContent = "…";
              d.style.cssText = "color:var(--faint); font-family:'Space Mono',monospace; padding:0 4px;";
              pager.appendChild(d);
            } else pager.appendChild(pbtn(String(n), { active: n === page, onClick: () => go(n) }));
          }
          pager.appendChild(pbtn("›", { disabled: page === total, onClick: () => go(page + 1) }));
        }
        render();
      })();
    </script>
  )}
</Base>
