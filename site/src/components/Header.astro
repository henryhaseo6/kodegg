---
// Header sticky — dipindah dari mockup. Perbedaan penting: toggle ID/EN bukan
// lagi tombol yang menukar teks di klien, melainkan TAUTAN ke halaman bahasa
// lain. Toggle klien membuat crawler hanya melihat satu bahasa (lihat schema.md).
import { t } from "../lib/i18n.mjs";
import { route, langPaths } from "../lib/routes.mjs";

// active = kunci halaman logis yang aktif (discover/codes/news) atau null.
// paths = {id, en} untuk toggle bahasa; default ke Beranda bila tak diberikan.
const { lang, active = null, paths = langPaths("home") } = Astro.props;
const tr = t(lang);
const nav = [
  { key: "nav.discover", page: "discover" },
  { key: "nav.codes", page: "codes" },
  { key: "nav.news", page: "news" },
].map((n) => ({ ...n, href: route(n.page, lang), current: n.page === active }));
---

<header
  style="position:sticky; top:0; z-index:60; background:rgba(9,12,18,0.72); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); border-bottom:1px solid var(--line);"
>
  <div
    style="max-width:1280px; margin:0 auto; padding:0 28px; height:70px; display:flex; align-items:center; gap:30px;"
  >
    <a href={`/${lang}`} style="display:flex; align-items:center; gap:11px; text-decoration:none;">
      <span
        style="width:34px; height:34px; border-radius:10px; background:#0E121B; border:2px solid var(--acc); display:flex; align-items:center; justify-content:center; box-shadow:0 0 24px rgba(203,255,70,0.35); font-family:'Space Grotesk',sans-serif; font-weight:800; font-size:22px; color:var(--acc); letter-spacing:-0.04em;"
        >GG</span
      >
      <span
        style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:22px; letter-spacing:-0.01em; color:var(--txt);"
        >KODE<span style="color:var(--acc);">GG</span></span
      >
    </a>

    <nav class="gg-headnav" style="display:flex; align-items:center; gap:24px; margin-left:6px;">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="gg-nav"
            aria-current={item.current ? "page" : undefined}
            style={`font-size:14.5px; font-weight:500; text-decoration:none; color:${item.current ? "var(--acc)" : "var(--muted)"};`}
          >
            {tr(item.key)}
          </a>
        ))
      }
    </nav>

    <div style="margin-left:auto; display:flex; align-items:center; gap:12px;">
      <div
        style="display:flex; background:var(--surface); border:1px solid var(--line); border-radius:10px; padding:2px;"
      >
        {
          ["id", "en"].map((l) => {
            const on = l === lang;
            return (
              <a
                href={paths[l]}
                hreflang={l}
                aria-current={on ? "true" : undefined}
                style={`display:block; text-decoration:none; font-family:'Space Mono',monospace; font-size:12px; font-weight:700; padding:5px 9px; border-radius:8px; background:${on ? "var(--surface2)" : "transparent"}; color:${on ? "var(--txt)" : "var(--faint)"};`}
              >
                {l.toUpperCase()}
              </a>
            );
          })
        }
      </div>
      <button
        class="gg-menu-btn"
        data-menu-btn
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        style="display:none; cursor:pointer; width:40px; height:40px; border-radius:10px; border:1px solid var(--line); background:var(--surface); color:var(--txt); align-items:center; justify-content:center;"
      >
        <svg data-menu-open width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
        <svg data-menu-close width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" style="display:none;"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
  </div>

  <!-- NAV MOBILE (muncul saat hamburger ditekan; disembunyikan di desktop) -->
  <nav class="gg-mobile-nav" data-mobile-nav style="display:none; border-top:1px solid var(--line); padding:6px 20px 12px; background:rgba(9,12,18,0.96);">
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-current={item.current ? "page" : undefined}
          style={`display:block; padding:13px 6px; font-size:16px; font-weight:600; text-decoration:none; border-bottom:1px solid var(--line); color:${item.current ? "var(--acc)" : "var(--txt)"};`}
        >
          {tr(item.key)}
        </a>
      ))
    }
  </nav>
</header>

<script is:inline>
  (function () {
    const btn = document.querySelector("[data-menu-btn]");
    const panel = document.querySelector("[data-mobile-nav]");
    if (!btn || !panel) return;
    const openI = btn.querySelector("[data-menu-open]");
    const closeI = btn.querySelector("[data-menu-close]");
    btn.addEventListener("click", () => {
      const open = panel.style.display !== "none";
      panel.style.display = open ? "none" : "block";
      btn.setAttribute("aria-expanded", String(!open));
      if (openI) openI.style.display = open ? "block" : "none";
      if (closeI) closeI.style.display = open ? "none" : "block";
    });
  })();
</script>
