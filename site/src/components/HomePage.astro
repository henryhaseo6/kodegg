---
// Beranda — agregasi ringkas: hero + kode redeem terbaru + berita & event +
// game trending. Tiap section menaut ke halaman penuh.
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FeedCard from "./FeedCard.astro";
import FeedModal from "./FeedModal.astro";
import CountdownScript from "./CountdownScript.astro";
import { t } from "../lib/i18n.mjs";
import { route, langPaths } from "../lib/routes.mjs";

const { lang, codes, catalog, feed, roblox } = Astro.props;
const tr = t(lang);
const id = lang === "id";
const L = (p) => `/${lang}${p}${p.endsWith("/") ? "" : "/"}`;
const fmtNum = (n) => new Intl.NumberFormat(id ? "id-ID" : "en-GB").format(n);
const nowMs = Date.now();
const fmtDate = (iso) =>
  new Date(iso).toLocaleDateString(id ? "id-ID" : "en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "Asia/Jakarta" });

const topCodes = codes.active.slice(0, 8);
const topRoblox = roblox?.top ?? []; // kode Roblox terbaru (RoCodes)
const trendingRoblox = roblox?.trending ?? []; // game Roblox teramai (dinamis/jam)
// Pemain konkuren → ringkas. Hindari regex literal di frontmatter .astro.
function fmtPlayers(n) {
  if (n >= 1e6) {
    const m = (n / 1e6).toFixed(1);
    return (m.endsWith(".0") ? m.slice(0, -2) : m) + "M";
  }
  if (n >= 1e3) return Math.round(n / 1e3) + "K";
  return String(n);
}
const topFeed = feed.items.slice(0, 8); // event + berita tercampur, terbaru dulu
const trending = [...catalog.games].sort((a, b) => a.pop - b.pop).slice(0, 7); // 7 = pas 1 baris desktop

// Statistik hero. Lime (--acc) = umum/mobile; ungu (--acc2) = vertikal Roblox.
const stats = [
  [fmtNum(codes.counts.active), tr("stat.active"), "var(--acc)"],
  [fmtNum(catalog.games.length), tr("stat.games"), "var(--acc)"],
  [fmtNum(roblox?.counts?.active ?? 0), id ? "kode Roblox" : "Roblox codes", "var(--acc2)"],
  [fmtNum(roblox?.gamesCount ?? 0), id ? "game Roblox" : "Roblox games", "var(--acc2)"],
  [fmtNum(feed.counts.events), id ? "event" : "events", "var(--acc)"],
  [fmtNum(feed.counts.news), id ? "berita" : "articles", "var(--acc)"],
];

const SectionHead = "font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:26px; letter-spacing:-0.02em; color:#fff; margin:0;";
const More = "font-family:'Space Mono',monospace; font-size:12px; font-weight:700; color:var(--acc); text-decoration:none;";
---

<Header lang={lang} active={null} paths={langPaths("home")} />

<main id="main">
  <!-- HERO -->
  <section class="gg-hero" style="max-width:1280px; margin:0 auto; padding:36px 28px 26px;">
    <div class="gg-hero-badge" style="display:inline-flex; align-items:center; gap:8px; font-family:'Space Mono',monospace; font-size:12px; letter-spacing:0.16em; color:var(--acc); margin-bottom:18px;">
      <span class="gg-pulse" style="width:7px; height:7px; border-radius:50%; background:var(--ok); animation:glowPulse 1.8s infinite;"></span>
      {id ? "OTOMATIS · DIPERBARUI TIAP JAM" : "AUTOMATED · UPDATED HOURLY"}
    </div>
    <h1 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(28px,4.5vw,44px); line-height:1.04; letter-spacing:-0.03em; color:#fff; margin:0 0 18px; text-wrap:balance;">
      {id ? "Semua info game online & Roblox, di satu tempat." : "All your online game & Roblox info, in one place."}
    </h1>
    <p style="font-size:17px; line-height:1.55; color:var(--muted); margin:0 0 30px;">
      {id ? "Kode redeem game online & Roblox, event & banner, dan berita — ditarik otomatis dari sumber tepercaya dan diperbarui tiap jam." : "Redeem codes for online games & Roblox, events & banners, and news — pulled automatically from trusted sources and refreshed hourly."}
    </p>
    <div class="gg-stats" style="display:flex; flex-wrap:wrap; gap:26px;">
      {stats.map(([n, label, color]) => (
        <div class="gg-stat" style="display:flex; align-items:baseline; gap:8px;">
          <span style={`font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:24px; color:${color};`}>{n}</span>
          <span style="font-family:'Space Mono',monospace; font-size:11px; color:var(--faint); text-transform:uppercase; letter-spacing:0.06em;">{label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- REDEEM -->
  <section class="gg-redeem" style="max-width:1280px; margin:0 auto; padding:28px 28px;">
    <div class="gg-sechead" style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:16px; gap:12px;">
      <h2 style={SectionHead}>{id ? "Kode redeem terbaru" : "Latest redeem codes"}</h2>
      <a href={route("codes", lang)} style={More}>{id ? "Semua kode" : "All codes"} →</a>
    </div>
    <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr)); gap:16px;">
      {topCodes.map((c) => (
        <div class:list={["gg-card", { "gg-new-card": c.isNew }]} style={`background:var(--surface); border:1px solid ${c.isNew ? "rgba(203,255,70,0.5)" : "var(--line)"}; border-radius:16px; padding:17px; display:flex; flex-direction:column; gap:11px;${c.isNew ? " box-shadow:0 0 0 1px rgba(203,255,70,0.12),0 10px 30px rgba(203,255,70,0.08);" : ""}`}>
          <div style="display:flex; align-items:center; gap:9px;">
            {c.icon && <img src={c.icon} alt="" width="30" height="30" style="border-radius:8px; object-fit:cover; flex:0 0 auto;" onerror="this.style.display='none'" />}
            {c.game ? (
              <a href={`/${lang}/game/${c.gameSlug}/`} class="gg-game-link" style="font-size:13.5px; font-weight:700; color:var(--txt); min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; text-decoration:none;">{c.name}</a>
            ) : (
              <span style="font-size:13.5px; font-weight:700; color:var(--txt); min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{c.name}</span>
            )}
            {c.isNew && (
              <span class="gg-new" style="flex:0 0 auto; margin-left:auto; display:inline-flex; align-items:center; gap:5px; font-family:'Space Mono',monospace; font-size:10px; font-weight:700; color:var(--ink); background:var(--acc); padding:3px 7px; border-radius:7px;">
                <span class="gg-new-dot" aria-hidden="true" style="width:4px; height:4px; border-radius:50%; background:var(--ink);" />
                {tr("card.new")}
              </span>
            )}
          </div>
          {c.reward && <div style="font-size:12px; color:var(--muted); line-height:1.4; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{c.reward}</div>}
          <div style="display:flex; align-items:center; gap:8px; margin-top:auto;">
            <code style="flex:1; min-width:0; font-family:'Space Mono',monospace; font-size:13px; font-weight:700; color:var(--acc); background:var(--bg); border:1px dashed var(--line2); border-radius:9px; padding:9px 11px; text-align:center; overflow:hidden; text-overflow:ellipsis;">{c.code ?? "—"}</code>
            {c.code && (
              <button class="gg-copy" data-copy={c.code} data-label={tr("card.copy")} data-done={tr("card.copied")} type="button"
                style="cursor:pointer; font-family:'Space Mono',monospace; font-size:12px; font-weight:700; border:1px solid var(--line2); color:var(--txt); background:var(--surface2); border-radius:9px; padding:9px 12px; transition:all .15s; flex:0 0 auto;">
                {tr("card.copy")}
              </button>
            )}
          </div>
          <div style="display:flex; justify-content:center; align-items:center; min-height:14px;">
            {c.perm ? (
              <span style="font-family:'Space Mono',monospace; font-size:10.5px; font-weight:700; color:var(--ok);">{id ? "Tanpa batas" : "No expiry"}</span>
            ) : c.endsAt && Date.parse(c.endsAt) > nowMs ? (
              <span style="display:inline-flex; align-items:center; gap:5px;">
                <span style="font-family:'Space Mono',monospace; font-size:10px; color:var(--faint);">{tr("ev.endsIn")}</span>
                <span data-deadline={c.endsAt} data-ended={tr("ev.ended")} style="font-family:'Space Mono',monospace; font-size:11px; font-weight:700; color:var(--warn); white-space:nowrap;">—</span>
              </span>
            ) : c.date ? (
              <span style="font-family:'Space Mono',monospace; font-size:10.5px; color:var(--faint);">{id ? "Rilis" : "Released"} {fmtDate(c.date)}</span>
            ) : c.firstSeenAt ? (
              <span style="font-family:'Space Mono',monospace; font-size:10.5px; color:var(--faint);">{tr("card.seen")} {fmtDate(c.firstSeenAt)}</span>
            ) : null}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- KODE ROBLOX — vertikal terpisah (RoCodes), aksen ungu utk bedakan -->
  {topRoblox.length > 0 && (
    <section style="max-width:1280px; margin:0 auto; padding:28px 28px; background:var(--bg2); border-top:1px solid var(--line); border-bottom:1px solid var(--line);">
      <div class="gg-sechead" style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; gap:12px; flex-wrap:wrap;">
        <div style="display:flex; align-items:center; gap:11px; flex-wrap:wrap;">
          <h2 style={SectionHead}>{id ? "Kode Roblox terbaru" : "Latest Roblox codes"}</h2>
          <span style="font-family:'Space Mono',monospace; font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:var(--acc2); border:1px solid rgba(139,107,255,0.5); background:rgba(139,107,255,0.1); padding:4px 9px; border-radius:7px;">Roblox</span>
          <span style="display:inline-flex; align-items:center; gap:6px; font-family:'Space Mono',monospace; font-size:11px; color:var(--muted);">
            <span class="gg-pulse" style="width:7px; height:7px; border-radius:50%; background:var(--ok); animation:glowPulse 1.8s infinite;"></span>{id ? "sync cepat" : "fast sync"}
          </span>
        </div>
        <a href={L("/roblox")} style={`${More} color:var(--acc2);`}>{id ? "Semua game Roblox" : "All Roblox games"} →</a>
      </div>
      <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr)); gap:16px;">
        {topRoblox.map((c) => (
          <div class="gg-card" style="background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:17px; display:flex; flex-direction:column; gap:11px;">
            <div style="display:flex; align-items:center; gap:9px;">
              {c.icon && <img src={c.icon} alt="" width="30" height="30" style="border-radius:8px; object-fit:cover; flex:0 0 auto;" onerror="this.style.display='none'" />}
              <a href={`${L("/roblox/")}${c.gameSlug}/`} class="gg-game-link" style="font-size:13.5px; font-weight:700; color:var(--txt); min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; text-decoration:none;">{c.name}</a>
              {/* Baru & Verified berdampingan (lihat CodeCard.astro). */}
              <span style="flex:0 0 auto; margin-left:auto; display:inline-flex; align-items:center; gap:5px;">
                {c.isNew && (
                  <span style="display:inline-flex; align-items:center; gap:5px; font-family:'Space Mono',monospace; font-size:10px; font-weight:700; color:#fff; background:var(--acc2); padding:3px 7px; border-radius:7px;">
                    {id ? "Baru" : "New"}
                  </span>
                )}
                {c.verified && (
                  <span style="display:inline-flex; align-items:center; gap:4px; font-family:'Space Mono',monospace; font-size:10px; font-weight:700; color:var(--ink); background:var(--ok); padding:3px 7px; border-radius:7px;">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>Verified
                  </span>
                )}
              </span>
            </div>
            {c.reward && <div style="font-size:12px; color:var(--muted); line-height:1.4; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{c.reward}</div>}
            <div style="display:flex; align-items:center; gap:8px; margin-top:auto;">
              <code style="flex:1; min-width:0; font-family:'Space Mono',monospace; font-size:13px; font-weight:700; color:var(--acc2); background:var(--bg); border:1px dashed var(--line2); border-radius:9px; padding:9px 11px; text-align:center; overflow:hidden; text-overflow:ellipsis;">{c.code ?? "—"}</code>
              {c.code && (
                <button class="gg-copy2" data-copy={c.code} data-label={tr("card.copy")} data-done={tr("card.copied")} type="button"
                  style="cursor:pointer; font-family:'Space Mono',monospace; font-size:12px; font-weight:700; border:1px solid rgba(139,107,255,0.4); color:var(--acc2); background:var(--surface2); border-radius:9px; padding:9px 12px; transition:all .15s; flex:0 0 auto;">
                  {tr("card.copy")}
                </button>
              )}
            </div>
            <div style="display:flex; justify-content:center; align-items:center; min-height:14px;">
              {c.endsAt && Date.parse(c.endsAt) > nowMs ? (
                <span style="display:inline-flex; align-items:center; gap:5px;">
                  <span style="font-family:'Space Mono',monospace; font-size:10px; color:var(--faint);">{tr("ev.endsIn")}</span>
                  <span data-deadline={c.endsAt} data-ended={tr("ev.ended")} style="font-family:'Space Mono',monospace; font-size:11px; font-weight:700; color:var(--warn); white-space:nowrap;">—</span>
                </span>
              ) : c.date ? (
                <span style="font-family:'Space Mono',monospace; font-size:10.5px; color:var(--faint);">{id ? "Rilis" : "Released"} {fmtDate(c.date)}</span>
              ) : c.firstSeenAt ? (
                <span style="font-family:'Space Mono',monospace; font-size:10.5px; color:var(--faint);">{tr("card.seen")} {fmtDate(c.firstSeenAt)}</span>
              ) : null}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- BERITA & EVENT — kartu klik → modal (sama seperti halaman feed) -->
  {topFeed.length > 0 && (
    <section style="max-width:1280px; margin:0 auto; padding:28px 28px; background:var(--bg2); border-top:1px solid var(--line); border-bottom:1px solid var(--line);">
      <div class="gg-sechead" style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:16px; gap:12px;">
        <h2 style={SectionHead}>{id ? "Berita & event terbaru" : "Latest news & events"}</h2>
        <a href={route("news", lang)} style={More}>{id ? "Semua update" : "All updates"} →</a>
      </div>
      <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(268px,100%),1fr)); gap:16px;">
        {topFeed.map((it) => <FeedCard it={it} lang={lang} />)}
      </div>
    </section>
  )}

  <!-- TRENDING GAMES -->
  <section style="max-width:1280px; margin:0 auto; padding:28px 28px;">
    <div class="gg-trend-head" style="display:flex; flex-wrap:wrap; align-items:center; gap:8px 10px; margin-bottom:16px;">
      <h2 class="gg-trend-title" style={SectionHead}>{id ? "Game trending" : "Trending games"}</h2>
      <a href={route("discover", lang)} style={`${More} margin-left:auto;`}>{id ? "Jelajah semua" : "Browse all"} →</a>
    </div>
    <div class="gg-trend-grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:16px;">
      {trending.map((g) => (
        <article class="gg-card" style="display:flex; flex-direction:column; background:var(--surface); border:1px solid var(--line); border-radius:16px; overflow:hidden; width:100%; max-width:260px; margin-inline:auto;">
          <div style="position:relative; aspect-ratio:1/1; background:var(--surface2);">
            {g.cover ? (
              <img src={g.cover} alt={g.name} width="256" height="256" loading="lazy" decoding="async"
                style="width:100%; height:100%; object-fit:cover; display:block;"
                onerror="this.style.display='none';this.parentElement.style.background='linear-gradient(135deg,var(--surface2),var(--bg2))';" />
            ) : (
              <span aria-hidden="true" style="display:block; width:100%; height:100%; background:linear-gradient(135deg,var(--surface2),var(--bg2));" />
            )}
            <button class="gg-fav" data-fav={g.id} type="button" aria-pressed="false" aria-label={lang === "id" ? "Favorit" : "Save"}
              style="position:absolute; top:8px; right:8px; width:30px; height:30px; border-radius:9px; border:1px solid var(--line2); background:rgba(9,12,18,0.72); color:var(--muted); cursor:pointer; display:flex; align-items:center; justify-content:center; padding:0;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"></path></svg>
            </button>
            {g.hasActiveCodes && (
              <span style="position:absolute; bottom:8px; left:8px; font-family:'Space Mono',monospace; font-size:10px; font-weight:700; color:var(--ink); background:var(--acc); padding:3px 7px; border-radius:6px;">
                {tr("cat.hasCodes")}
              </span>
            )}
          </div>
          <div style="padding:12px 13px; display:flex; flex-direction:column; gap:6px; flex:1;">
            <div style="font-size:13.5px; font-weight:700; color:var(--txt); line-height:1.2; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{g.name}</div>
            <div style="font-family:'Space Mono',monospace; font-size:10.5px; color:var(--faint);">
              {(g.genreLabels ?? []).slice(0, 2).join(" · ")}{g.rating ? ` · ★ ${g.rating}` : ""}
            </div>
            <div style="margin-top:auto; padding-top:4px;">
              {g.hasCodes ? (
                <a href={L(`/game/${g.slug}`)} style="display:inline-block; font-family:'Space Mono',monospace; font-size:11px; font-weight:700; color:var(--acc); text-decoration:none; border-bottom:1px solid rgba(203,255,70,0.35);">
                  {tr("cat.viewCodes")} →
                </a>
              ) : (
                <span style="font-family:'Space Mono',monospace; font-size:11px; color:var(--faint);">{tr("cat.browseOnly")}</span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>


  <!-- TRENDING ROBLOX — game teramai (pemain terbanyak, dinamis tiap jam) -->
  {trendingRoblox.length > 0 && (
    <section style="max-width:1280px; margin:0 auto; padding:28px 28px;">
      <div class="gg-trend-head" style="display:flex; flex-wrap:wrap; align-items:center; gap:8px 10px; margin-bottom:16px;">
        <h2 class="gg-trend-title" style={SectionHead}>{id ? "Game Roblox trending" : "Trending Roblox games"}</h2>
        <span style="flex:none; font-family:'Space Mono',monospace; font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:var(--acc2); border:1px solid rgba(139,107,255,0.5); background:rgba(139,107,255,0.1); padding:4px 9px; border-radius:7px;">Roblox</span>
        <a href={L("/roblox")} style={`${More} color:var(--acc2); margin-left:auto;`}>{id ? "Jelajah semua" : "Browse all"} →</a>
      </div>
      <div class="gg-trend-grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:16px;">
        {trendingRoblox.map((g) => (
          <article class="gg-card" style="display:flex; flex-direction:column; background:var(--surface); border:1px solid var(--line); border-radius:16px; overflow:hidden; width:100%; max-width:260px; margin-inline:auto;">
            <div style="position:relative; aspect-ratio:1/1; background:var(--surface2);">
              <img src={g.icon} alt={g.name} width="256" height="256" loading="lazy" decoding="async"
                style="width:100%; height:100%; object-fit:cover; display:block;"
                onerror="this.style.display='none';this.parentElement.style.background='linear-gradient(135deg,var(--surface2),var(--bg2))';" />
              <button class="gg-fav" data-fav={g.id} type="button" aria-pressed="false" aria-label={id ? "Favorit" : "Save"}
                style="position:absolute; top:8px; right:8px; width:30px; height:30px; border-radius:9px; border:1px solid var(--line2); background:rgba(9,12,18,0.72); color:var(--muted); cursor:pointer; display:flex; align-items:center; justify-content:center; padding:0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"></path></svg>
              </button>
              {g.verified ? (
                <span style="position:absolute; bottom:8px; left:8px; display:inline-flex; align-items:center; gap:4px; font-family:'Space Mono',monospace; font-size:10px; font-weight:700; color:var(--ink); background:var(--ok); padding:3px 7px; border-radius:6px;">✓ Verified</span>
              ) : (
                <span style="position:absolute; bottom:8px; left:8px; font-family:'Space Mono',monospace; font-size:10px; font-weight:700; color:#fff; background:var(--acc2); padding:3px 7px; border-radius:6px;">{tr("cat.hasCodes")}</span>
              )}
            </div>
            <div style="padding:12px 13px; display:flex; flex-direction:column; gap:6px; flex:1;">
              <div style="font-size:13.5px; font-weight:700; color:var(--txt); line-height:1.2; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{g.name}</div>
              <div style="font-family:'Space Mono',monospace; font-size:10.5px; color:var(--faint); display:flex; align-items:center; gap:5px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                {g.players ? `${fmtPlayers(g.players)} ${id ? "pemain" : "players"}` : g.genre}
              </div>
              <div style="margin-top:auto; padding-top:4px;">
                <a href={L(`/roblox/${g.slug}`)} style="display:inline-block; font-family:'Space Mono',monospace; font-size:11px; font-weight:700; color:var(--acc2); text-decoration:none; border-bottom:1px solid rgba(139,107,255,0.4);">
                  {tr("cat.viewCodes")} →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
</main>

<FeedModal lang={lang} />
<Footer lang={lang} updatedAt={codes.updatedAt} />
<CountdownScript lang={lang} />

<script is:inline>
  // Salin kode di kartu homepage. Clipboard API dulu, JATUH ke execCommand
  // (tetap jalan di konteks tanpa Clipboard API async).
  (function () {
    function legacyCopy(text) {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.cssText = "position:fixed;top:-9999px";
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, text.length);
      let ok = false;
      try { ok = document.execCommand("copy"); } catch { ok = false; }
      document.body.removeChild(ta);
      return ok;
    }
    for (const btn of document.querySelectorAll("[data-copy]")) {
      btn.addEventListener("click", () => {
        const code = btn.getAttribute("data-copy");
        const done = btn.getAttribute("data-done") || "✓";
        const label = btn.getAttribute("data-label") || "Copy";
        const flash = () => {
          btn.textContent = done;
          btn.style.background = "var(--acc)";
          btn.style.color = "var(--ink)";
          btn.style.borderColor = "var(--acc)";
          setTimeout(() => {
            btn.textContent = label;
            btn.style.background = "var(--surface2)";
            btn.style.color = "var(--txt)";
            btn.style.borderColor = "var(--line2)";
          }, 1400);
        };
        let handled = false;
        try {
          if (navigator.clipboard && navigator.clipboard.writeText && window.isSecureContext) {
            const pr = navigator.clipboard.writeText(code);
            if (pr && typeof pr.then === "function") {
              handled = true;
              pr.then(flash).catch(() => { legacyCopy(code); flash(); });
            }
          }
        } catch { /* jatuh ke legacy */ }
        if (!handled) { legacyCopy(code); flash(); }
      });
    }

    // Favorit game (localStorage) — sinkron dengan halaman Jelajah & Favorit.
    const KEY = "kodegg:fav";
    const favs = new Set(JSON.parse(localStorage.getItem(KEY) || "[]"));
    const paint = (btn, on) => {
      btn.style.color = on ? "var(--acc)" : "var(--muted)";
      btn.style.borderColor = on ? "var(--acc)" : "var(--line2)";
      btn.setAttribute("aria-pressed", String(on));
      btn.querySelector("svg").setAttribute("fill", on ? "var(--acc)" : "none");
    };
    for (const btn of document.querySelectorAll("[data-fav]")) {
      if (favs.has(btn.dataset.fav)) paint(btn, true);
      btn.addEventListener("click", () => {
        const fid = btn.dataset.fav;
        if (favs.has(fid)) favs.delete(fid);
        else favs.add(fid);
        localStorage.setItem(KEY, JSON.stringify([...favs]));
        window.dispatchEvent(new Event("kodegg:fav")); // update badge header
        paint(btn, favs.has(fid));
      });
    }
  })();
</script>
