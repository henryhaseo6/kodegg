---
// Modal detail feed (event & berita) + countdown. Dipicu klik [data-feed];
// payload dari data-payload kartu. Selalu ada tombol "Buka di sumber".
import { t } from "../lib/i18n.mjs";
const { lang } = Astro.props;
const tr = t(lang);
const id = lang === "id";
---

<div data-modal style="display:none; position:fixed; inset:0; z-index:100; background:rgba(9,12,18,0.82); backdrop-filter:blur(6px); align-items:flex-start; justify-content:center; padding:20px; overflow-y:auto;">
  <div role="dialog" aria-modal="true" aria-labelledby="feed-modal-title" style="background:var(--surface); border:1px solid var(--line2); border-radius:20px; max-width:640px; width:100%; margin:auto; box-shadow:0 30px 80px rgba(0,0,0,0.6); overflow:hidden;">
    <div data-m-hero style="position:relative; aspect-ratio:16/9; background:var(--surface2);">
      <button data-m-close type="button" aria-label={tr("ev.close")} style="position:absolute; top:12px; right:12px; z-index:2; cursor:pointer; width:34px; height:34px; border-radius:10px; border:1px solid var(--line2); background:rgba(9,12,18,0.8); color:#fff; font-size:18px; line-height:1;">×</button>
    </div>
    <div style="padding:20px 22px;">
      <div data-m-game style="font-family:'Space Mono',monospace; font-size:11px; color:var(--acc); margin-bottom:5px;"></div>
      <div id="feed-modal-title" data-m-title style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:20px; color:var(--txt); line-height:1.25;"></div>
      <div data-m-meta style="display:flex; align-items:center; flex-wrap:wrap; gap:8px 16px; margin:10px 0 16px; font-family:'Space Mono',monospace; font-size:12px;"></div>
      <div data-m-body></div>
      <a data-m-src rel="noopener nofollow" target="_blank"
        style="display:inline-flex; align-items:center; gap:8px; margin-top:18px; text-decoration:none; font-family:'Space Mono',monospace; font-size:13px; font-weight:700; color:var(--ink); background:var(--acc); border-radius:11px; padding:11px 18px;">
        <span data-m-src-label></span> ↗
      </a>
    </div>
  </div>
</div>

<script is:inline define:vars={{ lang, L_CHAR: id ? "Karakter" : "Characters", L_WEAP: id ? "Senjata" : "Weapons", L_REW: id ? "Reward" : "Rewards", L_ENDS: id ? "Berakhir dalam" : "Ends in", L_ENDED: id ? "Berakhir" : "Ended", L_SRC: id ? "Buka di sumber" : "Open at source", L_NODETAIL: id ? "Detail lengkap belum tersedia dari sumber — buka di sumber untuk info penuh." : "Full details aren't available here — open at the source for more." }}>
  (function () {
    function fmt(ms) {
      if (ms <= 0) return null;
      const d = Math.floor(ms / 86400000), h = Math.floor((ms % 86400000) / 3600000), m = Math.floor((ms % 3600000) / 60000), s = Math.floor((ms % 60000) / 1000);
      if (d > 0) return `${d}${lang === "id" ? "h" : "d"} ${h}${lang === "id" ? "j" : "h"} ${m}m`;
      return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
    }
    function tick() {
      const now = Date.now();
      for (const el of document.querySelectorAll("[data-deadline]")) {
        const dl = el.getAttribute("data-deadline");
        if (!dl) continue;
        const t = Date.parse(dl);
        if (isNaN(t)) continue;
        const left = fmt(t - now);
        el.textContent = left === null ? el.getAttribute("data-ended") : left;
      }
    }
    tick();
    setInterval(tick, 1000);

    const modal = document.querySelector("[data-modal]");
    if (!modal) return;
    const mHero = modal.querySelector("[data-m-hero]");
    const mGame = modal.querySelector("[data-m-game]");
    const mTitle = modal.querySelector("[data-m-title]");
    const mMeta = modal.querySelector("[data-m-meta]");
    const mBody = modal.querySelector("[data-m-body]");
    const mSrc = modal.querySelector("[data-m-src]");
    const mSrcLabel = modal.querySelector("[data-m-src-label]");
    const esc = (s) => String(s).replace(/[&<>"]/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[ch]));

    function itemGrid(label, items, gold) {
      if (!items || !items.length) return "";
      const chips = items.map((it) => `
        <span style="display:flex; align-items:center; gap:6px; font-family:'Space Mono',monospace; font-size:11px; color:${gold && it.rarity === 5 ? "var(--warn)" : "var(--muted)"}; background:var(--surface2); border:1px solid var(--line); border-radius:8px; padding:4px 8px;">
          ${it.icon ? `<img src="${esc(it.icon)}" alt="" referrerpolicy="no-referrer" width="18" height="18" style="border-radius:50%; display:block;" onerror="this.style.display='none'">` : ""}
          ${esc(it.name)}${it.amount ? ` ×${esc(it.amount)}` : it.rarity === 5 ? " ★5" : ""}
        </span>`).join("");
      return `<div style="margin-bottom:16px;"><div style="font-family:'Space Mono',monospace; font-size:11px; letter-spacing:0.08em; color:var(--acc); margin-bottom:9px;">${esc(label).toUpperCase()}</div><div style="display:flex; flex-wrap:wrap; gap:7px;">${chips}</div></div>`;
    }

    const calIcon = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>`;

    function open(card) {
      const d = JSON.parse(card.dataset.payload);
      const isEvent = d.kind === "event";
      mHero.style.background = d.type === "banner" ? "linear-gradient(150deg,rgba(139,107,255,0.2),var(--surface2))" : "var(--surface2)";
      const old = mHero.querySelector("img"); if (old) old.remove();
      if (d.image) {
        const img = document.createElement("img");
        img.src = d.image; img.referrerPolicy = "no-referrer"; img.alt = "";
        img.style.cssText = `width:100%; height:100%; object-fit:${d.type === "banner" ? "contain" : "cover"}; display:block;`;
        img.onerror = () => img.remove();
        mHero.insertBefore(img, mHero.firstChild);
      }
      mGame.textContent = d.game;
      mTitle.textContent = d.title;

      // Meta: event → rentang tanggal + countdown; berita → tanggal posting.
      if (isEvent) {
        mMeta.innerHTML =
          (d.dates ? `<span style="display:inline-flex; align-items:center; gap:6px; color:var(--muted);">${calIcon}${esc(d.dates)}</span>` : "") +
          `<span style="display:inline-flex; align-items:center; gap:6px;"><span style="color:var(--faint);">${L_ENDS}</span><span data-deadline="${esc(d.endsAt || "")}" data-ended="${L_ENDED}" style="color:var(--warn); font-weight:700;">—</span></span>`;
      } else {
        mMeta.innerHTML = d.posted ? `<span style="display:inline-flex; align-items:center; gap:6px; color:var(--muted);">${calIcon}${esc(d.posted)}</span>` : "";
      }

      const detail =
        (d.desc ? `<p style="font-size:14px; line-height:1.7; color:var(--muted); margin:0;">${esc(d.desc)}</p>` : "") +
        itemGrid(L_CHAR, d.characters, true) + itemGrid(L_WEAP, d.weapons, true) + itemGrid(L_REW, d.rewards, false);
      mBody.innerHTML = detail || `<p style="font-size:13.5px; color:var(--faint); margin:0; line-height:1.6;">${L_NODETAIL}</p>`;

      // Tombol sumber — selalu ada bila ada url.
      if (d.url) {
        mSrc.href = d.url;
        mSrc.style.display = "inline-flex";
        mSrcLabel.textContent = d.source ? `${L_SRC} · ${d.source}` : L_SRC;
      } else {
        mSrc.style.display = "none";
      }

      tick();
      lastFocus = document.activeElement; // simpan pemicu untuk dikembalikan saat tutup
      modal.style.display = "flex";
      document.body.style.overflow = "hidden";
      closeBtn.focus(); // pindahkan fokus ke dalam modal
    }
    function close() {
      if (modal.style.display === "none") return;
      modal.style.display = "none";
      document.body.style.overflow = "";
      if (lastFocus && lastFocus.focus) lastFocus.focus(); // kembalikan fokus ke pemicu
    }
    // Focus trap: Tab tak boleh keluar dari modal saat terbuka.
    function trap(e) {
      if (e.key !== "Tab" || modal.style.display === "none") return;
      const f = [...modal.querySelectorAll('button, a[href], [tabindex]:not([tabindex="-1"])')].filter((el) => el.offsetParent !== null);
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
    let lastFocus = null;
    const closeBtn = modal.querySelector("[data-m-close]");
    document.querySelectorAll("[data-feed]").forEach((c) => c.addEventListener("click", () => open(c)));
    closeBtn.addEventListener("click", close);
    modal.addEventListener("click", (e) => { if (e.target === modal) close(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
    modal.addEventListener("keydown", trap);
  })();
</script>
