---
// Isi halaman Kode Redeem. Dipakai kedua route bahasa (/id, /en).
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import CodeCard from "./CodeCard.astro";
import CountdownScript from "./CountdownScript.astro";
import { t } from "../lib/i18n.mjs";
import { langPaths } from "../lib/routes.mjs";

const { lang, data } = Astro.props;
const tr = t(lang);

const fmtNum = (n) => new Intl.NumberFormat(lang === "id" ? "id-ID" : "en-GB").format(n);
const fmtArchDate = (iso) =>
  new Date(iso).toLocaleDateString(lang === "id" ? "id-ID" : "en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "Asia/Jakarta",
  });
const PAGE = 8; // kartu per halaman (pagination)
const ARCH_PAGE = 24; // kartu arsip per halaman (pagination)
const ARCH_RENDER = 1300; // batas kartu arsip yang dirender ke DOM (SSG), sisanya via count
---

<Header lang={lang} active="codes" paths={langPaths("codes")} />

<main id="main">
  <!-- PAGE HEADER -->
  <section style="max-width:1280px; margin:0 auto; padding:48px 28px 8px;">
    <div style="display:inline-flex; align-items:center; gap:8px; font-family:'Space Mono',monospace; font-size:12px; letter-spacing:0.16em; color:var(--acc); margin-bottom:14px;">
      <span class="gg-pulse" style="width:7px; height:7px; border-radius:50%; background:var(--ok); animation:glowPulse 1.8s infinite;"></span>
      {tr("page.live")}
    </div>
    <h1 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:48px; line-height:1.02; letter-spacing:-0.03em; color:#fff; margin:0 0 14px;">
      {tr("page.title")}
    </h1>
    <p style="font-size:16.5px; line-height:1.55; color:var(--muted); margin:0 0 24px;">
      {tr("page.desc")}
    </p>
    <div style="display:flex; flex-wrap:wrap; gap:22px; margin-bottom:6px;">
      <div style="display:flex; align-items:baseline; gap:8px;">
        <span style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:22px; color:var(--acc);">{fmtNum(data.counts.active)}</span>
        <span style="font-family:'Space Mono',monospace; font-size:11px; color:var(--faint); text-transform:uppercase; letter-spacing:0.06em;">{tr("stat.active")}</span>
      </div>
      <div style="display:flex; align-items:baseline; gap:8px;">
        <span style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:22px; color:var(--txt);">{fmtNum(data.games.length)}</span>
        <span style="font-family:'Space Mono',monospace; font-size:11px; color:var(--faint); text-transform:uppercase; letter-spacing:0.06em;">{tr("stat.games")}</span>
      </div>
      <div style="display:flex; align-items:baseline; gap:8px;">
        <span style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:22px; color:var(--txt);">{fmtNum(data.counts.archived)}</span>
        <span style="font-family:'Space Mono',monospace; font-size:11px; color:var(--faint); text-transform:uppercase; letter-spacing:0.06em;">{tr("stat.archived")}</span>
      </div>
    </div>
  </section>

  <!-- CONTROLS -->
  <section style="max-width:1280px; margin:0 auto; padding:20px 28px 4px;">
    <div class="gg-controls" style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
      <div style="position:relative; flex:1; min-width:240px;">
        <span aria-hidden="true" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--faint); pointer-events:none;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
        </span>
        <input
          class="gg-ac-input"
          data-search-input
          type="search"
          autocomplete="off"
          aria-label={tr("ctl.search")}
          placeholder={tr("ctl.search")}
          style="width:100%; box-sizing:border-box; font-family:'Satoshi',sans-serif; font-size:14.5px; color:var(--txt); background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:13px 14px 13px 40px; outline:none;"
        />
      </div>
      <select class="gg-sel" data-game-select aria-label={tr("ctl.allGames")} style="font-family:'Satoshi',sans-serif; font-size:14px; font-weight:600; color:var(--txt); background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:13px 38px 13px 14px; cursor:pointer; outline:none; min-width:180px;">
        <option value="all">{tr("ctl.allGames")}</option>
        {data.games.map((g) => <option value={g.id}>{g.name}</option>)}
      </select>
      <select class="gg-sel" data-sort-select aria-label={tr("ctl.sortNew")} style="font-family:'Satoshi',sans-serif; font-size:14px; font-weight:600; color:var(--txt); background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:13px 38px 13px 14px; cursor:pointer; outline:none; min-width:168px;">
        <option value="new">{tr("ctl.sortNew")}</option>
        <option value="az">{tr("ctl.sortAZ")}</option>
      </select>
      <button data-new-toggle type="button" aria-pressed="false"
        style="cursor:pointer; font-family:'Space Mono',monospace; font-size:12.5px; font-weight:700; color:var(--muted); background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:13px 16px; display:inline-flex; align-items:center; gap:7px; white-space:nowrap; transition:all .15s;">
        <span data-new-dot style="width:6px; height:6px; border-radius:50%; background:var(--faint); display:inline-block;"></span>
        {lang === "id" ? "Baru saja" : "New only"}
      </button>
    </div>
    <div style="margin-top:14px; font-family:'Space Mono',monospace; font-size:12px; color:var(--faint);">
      <span data-count>{data.active.length}</span> {tr("ctl.shown")}
    </div>
  </section>

  <!-- ACTIVE GRID -->
  <section style="max-width:1280px; margin:0 auto; padding:12px 28px 8px;">
    <div data-code-grid style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr)); gap:18px;">
      {data.active.map((card) => <CodeCard card={card} lang={lang} />)}
    </div>
    <p data-empty style="display:none; text-align:center; color:var(--muted); font-size:15px; padding:40px 0;">
      {tr("ctl.empty")}
    </p>
    <nav data-pager aria-label="Pagination" style="display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:7px; margin-top:30px;"></nav>
  </section>

  <!-- ARCHIVE -->
  <section style="max-width:1280px; margin:0 auto; padding:40px 28px 8px;">
    <details>
      <summary style="display:flex; align-items:center; gap:12px; padding:18px 20px; background:var(--surface); border:1px solid var(--line); border-radius:16px;">
        <div style="flex:1;">
          <div style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:19px; color:var(--txt);">{tr("arch.title")}</div>
          <div style="font-size:13px; color:var(--muted); margin-top:3px;">{tr("arch.desc")}</div>
        </div>
        <span style="font-family:'Space Mono',monospace; font-size:12px; color:var(--faint);">{fmtNum(data.archive.length)} {tr("arch.count")}</span>
        <svg class="gg-arch-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.4" stroke-linecap="round" style="transition:transform .2s;"><path d="M6 9l6 6 6-6"></path></svg>
      </summary>

      <div style="padding-top:16px;">
        {
          data.archive.length === 0 ? (
            <div style="text-align:center; padding:30px 0; color:var(--faint);">
              <div style="font-weight:700; color:var(--muted); margin-bottom:4px;">{tr("arch.emptyTitle")}</div>
              <div style="font-size:13px;">{tr("arch.emptyDesc")}</div>
            </div>
          ) : (
            <>
              <div data-arch-grid style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(280px,100%),1fr)); gap:12px;">
                {data.archive.slice(0, ARCH_RENDER).map((c) => (
                  <div data-arch-card data-game={c.game ?? ""} data-search={c.search} style="background:var(--bg2); border:1px solid var(--line); border-radius:12px; padding:14px 16px; opacity:0.72;">
                    <div style="display:flex; align-items:center; justify-content:space-between; gap:8px;">
                      <span style="font-size:13px; font-weight:700; color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{c.name}</span>
                      <span style="font-family:'Space Mono',monospace; font-size:10px; font-weight:700; color:var(--danger); background:rgba(255,92,119,0.12); border:1px solid rgba(255,92,119,0.28); padding:3px 7px; border-radius:6px; flex:0 0 auto;">{tr("card.expired")}</span>
                    </div>
                    {c.code && (
                      <code style="display:block; margin-top:9px; font-family:'Space Mono',monospace; font-size:12.5px; color:var(--faint); text-decoration:line-through;">{c.code}</code>
                    )}
                    {c.date && (
                      <div style="margin-top:7px; font-family:'Space Mono',monospace; font-size:10px; color:var(--faint);">{fmtArchDate(c.date)}</div>
                    )}
                  </div>
                ))}
              </div>
              <div data-arch-empty style="display:none; text-align:center; padding:24px 0; color:var(--faint); font-size:13px;">{tr("arch.noMatch")}</div>
              <nav data-arch-pager aria-label="Pagination" style="display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:7px; margin-top:22px;"></nav>
            </>
          )
        }
      </div>
    </details>
  </section>

  <!-- HOW TO -->
  <section style="max-width:1280px; margin:0 auto; padding:44px 28px 8px;">
    <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:24px; color:var(--txt); margin:0 0 16px;">{tr("how.title")}</h2>
    <ol style="margin:0; padding-left:20px; color:var(--muted); font-size:14.5px; line-height:1.9;">
      <li>{tr("how.step1")}</li>
      <li>{tr("how.step2")}</li>
      <li>{tr("how.step3")}</li>
    </ol>
    <p style="margin:14px 0 0; font-size:13px; color:var(--faint); line-height:1.6; max-width:74ch;">{tr("how.note")}</p>
  </section>
</main>

<Footer lang={lang} updatedAt={data.updatedAt} />
<CountdownScript lang={lang} />

<script is:inline define:vars={{ PAGE, ARCH_PAGE }}>
  // Filter/sort/copy/muat-lebih. Menggantikan kelas Component dari support.js.
  // Dijalankan atas markup yang sudah dirender server — progressive enhancement:
  // tanpa JS, seluruh kartu tetap tampil dan bisa dibaca.
  (function () {
    const grid = document.querySelector("[data-code-grid]");
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll("[data-code-card]"));
    const searchEl = document.querySelector("[data-search-input]");
    const gameEl = document.querySelector("[data-game-select]");
    const sortEl = document.querySelector("[data-sort-select]");
    const countEl = document.querySelector("[data-count]");
    const emptyEl = document.querySelector("[data-empty]");
    const pager = document.querySelector("[data-pager]");

    // Arsip: kartu kadaluarsa yang ikut kefilter game + search yang sama, jadi
    // arsip berlaku sebagai database per-game (bukan daftar statis 60 kode).
    const archGrid = document.querySelector("[data-arch-grid]");
    const archCards = archGrid ? Array.from(archGrid.querySelectorAll("[data-arch-card]")) : [];
    const archEmptyEl = document.querySelector("[data-arch-empty]");
    const archPager = document.querySelector("[data-arch-pager]");

    const state = { q: "", game: "all", sort: "new", page: 1, archPage: 1, newOnly: false };
    const newToggle = document.querySelector("[data-new-toggle]");
    const newDot = document.querySelector("[data-new-dot]");

    function pageList(cur, total) {
      const want = new Set([1, total, cur, cur - 1, cur + 1]);
      const arr = [...want].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
      const out = [];
      let prev = 0;
      for (const n of arr) { if (n - prev > 1) out.push("…"); out.push(n); prev = n; }
      return out;
    }
    function pbtn(label, opts) {
      const el = document.createElement("button");
      el.type = "button";
      el.textContent = label;
      el.disabled = !!opts.disabled;
      el.style.cssText =
        "cursor:pointer; font-family:'Space Mono',monospace; font-size:13px; font-weight:700; min-width:38px; height:38px; padding:0 11px; border-radius:10px; border:1px solid " +
        (opts.active ? "var(--acc)" : "var(--line2)") + "; background:" + (opts.active ? "var(--acc)" : "var(--surface)") +
        "; color:" + (opts.active ? "var(--ink)" : opts.disabled ? "var(--faint)" : "var(--txt)") + (opts.disabled ? "; opacity:0.5; cursor:default" : "") + ";";
      if (opts.onClick && !opts.disabled) el.addEventListener("click", opts.onClick);
      return el;
    }
    function renderPager(total) {
      if (!pager) return;
      pager.innerHTML = "";
      if (total <= 1) return;
      const go = (n) => { state.page = n; apply(); grid.scrollIntoView({ behavior: "smooth", block: "start" }); };
      pager.appendChild(pbtn("‹", { disabled: state.page === 1, onClick: () => go(state.page - 1) }));
      for (const n of pageList(state.page, total)) {
        if (n === "…") {
          const d = document.createElement("span");
          d.textContent = "…";
          d.style.cssText = "color:var(--faint); font-family:'Space Mono',monospace; padding:0 4px;";
          pager.appendChild(d);
        } else pager.appendChild(pbtn(String(n), { active: n === state.page, onClick: () => go(n) }));
      }
      pager.appendChild(pbtn("›", { disabled: state.page === total, onClick: () => go(state.page + 1) }));
    }

    // Deep-link ?game=gi memfilter otomatis ke game itu. Selalu terapkan
    // filternya; kalau game itu tak punya kode aktif, hasilnya empty state
    // (BUKAN diam-diam menampilkan semua kode game lain).
    const wantGame = new URLSearchParams(location.search).get("game");
    if (wantGame) {
      state.game = wantGame;
      if (gameEl && [...gameEl.options].some((o) => o.value === wantGame)) gameEl.value = wantGame;
    }

    function apply() {
      const q = state.q.trim().toLowerCase();
      let shown = cards.filter((c) => {
        const okGame = state.game === "all" || c.dataset.game === state.game;
        const okQ = !q || (c.dataset.search || "").includes(q);
        const okNew = !state.newOnly || c.dataset.new === "1";
        return okGame && okQ && okNew;
      });

      shown.sort((a, b) => {
        if (state.sort === "az") return a.dataset.name.localeCompare(b.dataset.name);
        // "Terbaru": rankMs (tanggal rilis; atau firstSeen bila genuine baru;
        // 0 bila bulk-import) dulu, lalu firstSeen sebagai tiebreak.
        return (
          (Number(b.dataset.rank || 0) - Number(a.dataset.rank || 0)) ||
          (Number(b.dataset.seen || 0) - Number(a.dataset.seen || 0))
        );
      });

      const total = Math.max(1, Math.ceil(shown.length / PAGE));
      if (state.page > total) state.page = total;
      const start = (state.page - 1) * PAGE;
      const visible = new Set(shown.slice(start, start + PAGE));
      for (const c of cards) c.style.display = "none";
      for (const c of shown) {
        c.style.display = visible.has(c) ? "flex" : "none";
        grid.appendChild(c);
      }

      if (countEl) countEl.textContent = String(shown.length);
      if (emptyEl) emptyEl.style.display = shown.length === 0 ? "block" : "none";
      renderPager(total);

      applyArchive(q);
    }

    // Arsip: pager terpisah (banyak kode expired) — pakai pola pager yang sama
    // dengan kode aktif, tapi state.archPage & elemen [data-arch-pager] sendiri.
    function renderArchPager(total) {
      if (!archPager) return;
      archPager.innerHTML = "";
      if (total <= 1) return;
      const go = (n) => {
        state.archPage = n;
        applyArchive(state.q.trim().toLowerCase());
        if (archGrid) archGrid.scrollIntoView({ behavior: "smooth", block: "start" });
      };
      archPager.appendChild(pbtn("‹", { disabled: state.archPage === 1, onClick: () => go(state.archPage - 1) }));
      for (const n of pageList(state.archPage, total)) {
        if (n === "…") {
          const d = document.createElement("span");
          d.textContent = "…";
          d.style.cssText = "color:var(--faint); font-family:'Space Mono',monospace; padding:0 4px;";
          archPager.appendChild(d);
        } else archPager.appendChild(pbtn(String(n), { active: n === state.archPage, onClick: () => go(n) }));
      }
      archPager.appendChild(pbtn("›", { disabled: state.archPage === total, onClick: () => go(state.archPage + 1) }));
    }

    // Filter arsip pakai state game + query yang sama dengan kode aktif, lalu
    // paginasi ARCH_PAGE per halaman (bukan muat-lebih yang menumpuk).
    function applyArchive(q) {
      if (!archGrid) return;
      const shown = archCards.filter((c) => {
        const okGame = state.game === "all" || c.dataset.game === state.game;
        const okQ = !q || (c.dataset.search || "").includes(q);
        return okGame && okQ;
      });
      const total = Math.max(1, Math.ceil(shown.length / ARCH_PAGE));
      if (state.archPage > total) state.archPage = total;
      const start = (state.archPage - 1) * ARCH_PAGE;
      const visible = new Set(shown.slice(start, start + ARCH_PAGE));
      for (const c of archCards) c.style.display = visible.has(c) ? "block" : "none";
      if (archEmptyEl) archEmptyEl.style.display = shown.length === 0 ? "block" : "none";
      renderArchPager(total);
    }

    searchEl?.addEventListener("input", (e) => {
      state.q = e.target.value;
      state.page = 1;
      state.archPage = 1;
      apply();
    });
    gameEl?.addEventListener("change", (e) => {
      state.game = e.target.value;
      state.page = 1;
      state.archPage = 1;
      apply();
    });
    sortEl?.addEventListener("change", (e) => {
      state.sort = e.target.value;
      state.page = 1;
      apply();
    });
    // Toggle "Baru saja" — filter ke kode yang baru rilis (data-new=1).
    newToggle?.addEventListener("click", () => {
      state.newOnly = !state.newOnly;
      state.page = 1;
      newToggle.setAttribute("aria-pressed", String(state.newOnly));
      newToggle.style.color = state.newOnly ? "var(--ink)" : "var(--muted)";
      newToggle.style.background = state.newOnly ? "var(--acc)" : "var(--surface)";
      newToggle.style.borderColor = state.newOnly ? "var(--acc)" : "var(--line)";
      if (newDot) newDot.style.background = state.newOnly ? "var(--ink)" : "var(--faint)";
      apply();
    });

    // Salin ke clipboard dengan fallback bertingkat. Metode legacy (textarea +
    // execCommand) dijalankan pada gesture klik, jadi tetap bekerja di banyak
    // konteks tempat Clipboard API async diblokir (mis. iframe tersandbox).
    function legacyCopy(text) {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.top = "-9999px";
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, text.length);
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } catch {
        ok = false;
      }
      document.body.removeChild(ta);
      return ok;
    }

    grid.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-copy]");
      if (!btn) return;
      const code = btn.getAttribute("data-copy");
      const done = btn.getAttribute("data-done") || "✓";
      const label = btn.getAttribute("data-label") || "Copy";
      const flash = () => {
        btn.textContent = done;
        btn.style.background = "var(--acc)";
        btn.style.color = "var(--ink)";
        btn.style.borderColor = "var(--acc)";
        setTimeout(() => {
          btn.textContent = label;
          btn.style.background = "var(--surface2)";
          btn.style.color = "var(--txt)";
          btn.style.borderColor = "var(--line2)";
        }, 1400);
      };

      // Clipboard API dulu (butuh secure context + izin); kalau gagal/tak ada,
      // JATUH ke legacy — bukan langsung menyerah seperti sebelumnya.
      let handled = false;
      try {
        if (navigator.clipboard && navigator.clipboard.writeText && window.isSecureContext) {
          const p = navigator.clipboard.writeText(code);
          if (p && typeof p.then === "function") {
            handled = true;
            p.then(flash).catch(() => {
              legacyCopy(code);
              flash();
            });
          }
        }
      } catch {
        /* jatuh ke legacy di bawah */
      }
      if (!handled) {
        legacyCopy(code);
        flash();
      }
    });

    apply();
  })();
</script>
