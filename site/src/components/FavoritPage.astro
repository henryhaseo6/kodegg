---
// Halaman Favorit — game tersimpan (localStorage "kodegg:fav" dari ikon hati di
// Jelajah). Semua kartu dirender lalu difilter klien; hanya favorit yang tampil.
import Header from "./Header.astro";
import Breadcrumb from "./Breadcrumb.astro";
import Footer from "./Footer.astro";
import { t } from "../lib/i18n.mjs";
import { route, langPaths } from "../lib/routes.mjs";

const { lang, data } = Astro.props;
const tr = t(lang);
---

<Header lang={lang} active={null} paths={langPaths("saved")} />
<Breadcrumb items={[{ label: lang === "id" ? "Beranda" : "Home", href: route("home", lang) }, { label: tr("nav.saved") }]} />
<main style="max-width:1280px; margin:0 auto; padding:44px 28px 8px;">
  <h1 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:42px; letter-spacing:-0.03em; color:#fff; margin:0 0 12px;">{tr("fav.title")}</h1>
  <p style="font-size:16px; color:var(--muted); margin:0 0 24px;">{tr("fav.desc")}</p>

  <div data-grid style="display:grid; grid-template-columns:repeat(auto-fill,minmax(158px,1fr)); gap:16px;">
    {
      data.games.map((g) => (
        <div data-fav-card data-id={g.id} style="display:none; position:relative; flex-direction:column;">
          <a href={g.hasCodes ? `/${lang}/game/${g.slug}` : route("discover", lang)}
            style="display:flex; flex-direction:column; background:var(--surface); border:1px solid var(--line); border-radius:16px; overflow:hidden; text-decoration:none;">
            <div style="aspect-ratio:1/1; background:var(--surface2);">
              {g.cover && <img src={g.cover} alt={g.name} loading="lazy" style="width:100%; height:100%; object-fit:cover;" onerror="this.style.display='none'" />}
            </div>
            <div style="padding:11px 12px;">
              <div style="font-size:13px; font-weight:700; color:var(--txt); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{g.name}</div>
              <div style="font-family:'Space Mono',monospace; font-size:10px; color:var(--faint); margin-top:2px;">{g.genreLabels.slice(0, 2).join(" · ")}</div>
            </div>
          </a>
          <button data-remove type="button" aria-label={lang === "id" ? "Hapus dari favorit" : "Remove from saved"} title={lang === "id" ? "Hapus dari favorit" : "Remove from saved"}
            class="gg-fav-remove"
            style="position:absolute; top:8px; right:8px; width:28px; height:28px; border-radius:8px; border:1px solid var(--line2); background:rgba(9,12,18,0.78); color:var(--muted); cursor:pointer; display:flex; align-items:center; justify-content:center; padding:0; backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </button>
        </div>
      ))
    }
  </div>
  <div data-empty style="display:none; text-align:center; padding:50px 20px; color:var(--muted);">
    <p style="font-size:15px; margin:0 0 18px;">{tr("fav.empty")}</p>
    <a href={route("discover", lang)} class="gg-cta" style="display:inline-block; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:14px; color:var(--ink); background:var(--acc); text-decoration:none; border-radius:12px; padding:12px 22px;">{tr("fav.browse")} →</a>
  </div>
</main>
<Footer lang={lang} updatedAt={null} />

<script is:inline>
  (function () {
    const KEY = "kodegg:fav";
    const favs = new Set(JSON.parse(localStorage.getItem(KEY) || "[]"));
    const cards = document.querySelectorAll("[data-fav-card]");
    const empty = document.querySelector("[data-empty]");
    const grid = document.querySelector("[data-grid]");

    const refreshEmpty = () => {
      const shown = [...cards].filter((c) => c.style.display !== "none").length;
      if (empty) empty.style.display = shown === 0 ? "block" : "none";
      if (grid) grid.style.display = shown === 0 ? "none" : "grid";
    };

    cards.forEach((c) => {
      if (favs.has(c.dataset.id)) c.style.display = "flex";
      const rm = c.querySelector("[data-remove]");
      if (rm)
        rm.addEventListener("click", (e) => {
          e.preventDefault();
          favs.delete(c.dataset.id);
          localStorage.setItem(KEY, JSON.stringify([...favs]));
          window.dispatchEvent(new Event("kodegg:fav")); // update badge header
          c.style.display = "none";
          refreshEmpty();
        });
    });
    refreshEmpty();
  })();
</script>
