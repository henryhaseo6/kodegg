---
// Satu kartu kode redeem. Struktur & style dipindah dari mockup Kode Redeem.
//
// Tiga penyimpangan dari mockup, semuanya karena data ASLI berbeda dari sample:
//  1. Countdown "Berakhir dalam" → "Terpantau <relatif>". Sumber tidak
//     menyediakan tanggal kedaluwarsa (lihat schema/worker). Kode HoYo permanen
//     tetap ditandai "Tanpa batas".
//  2. Reward kosong (mis. Honkai Impact 3rd) → catatan kecil, bukan dikarang.
//  3. Giveaway GamerPower diklaim via tombol Klaim (URL), bukan kode + Salin.
import { t } from "../lib/i18n.mjs";

// linkGame: nama game ditautkan ke halaman game-nya (default true). Di-set false
// pada halaman per-game itu sendiri (tak perlu menaut ke diri sendiri).
// accent: warna aksen kartu — default lime (mobile). Vertikal Roblox pakai ungu
// (var(--acc2)) supaya konsisten dg section Roblox di homepage. gameBase: prefix
// path game ("game" mobile / "roblox").
const { card, lang, linkGame = true, accent = "var(--acc)", gameBase = "game" } = Astro.props;
const tr = t(lang);
const gameHref = card.gameSlug ? `/${lang}/${gameBase}/${card.gameSlug}/` : null;
// Turunan aksen (dipakai untuk kode, badge "Baru", sorotan kartu baru).
const isAcc2 = accent.includes("acc2");
const accentRgb = isAcc2 ? "139,107,255" : "203,255,70";
const badgeText = isAcc2 ? "#fff" : "var(--ink)";

const isClaim = !card.code && card.claimUrl; // giveaway GamerPower

// Tanggal ABSOLUT (bukan "hari ini" relatif — itu berubah tiap build & terlihat
// palsu saat semua kode tampak "hari ini"). Prioritas tanggal SUMBER (kolom
// Date/Released wiki); bila sumber tak punya tanggal (mis. API HoYo), pakai
// firstSeenAt (kapan worker pertama melihatnya) dengan label "Terpantau".
const fmtDate = (iso) =>
  new Date(iso).toLocaleDateString(lang === "id" ? "id-ID" : "en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "Asia/Jakarta",
  });

// Atribusi per-kode. `sources` = semua sumber yang menyumbang data kode ini.
// TIAP sumber ditautkan ke halaman aslinya bila URL-nya diketahui (sourceUrls,
// dibawa combineCodes); yang tak punya URL tampil sebagai teks kredit.
const allSources = card.sources?.length ? card.sources : card.source ? [card.source] : [];
const primarySource = card.source ?? allSources[0] ?? null;
// URL per sumber: dari peta sourceUrls; fallback sourceUrl untuk sumber utama.
const srcUrl = (s) => card.sourceUrls?.[s] ?? (s === primarySource ? card.sourceUrl : null);

// Countdown kedaluwarsa: hanya untuk kode berbatas waktu (endsAt di masa depan,
// mis. kode livestream ~48 jam). Ticker real-time via CountdownScript. Tampil
// menggantikan label tanggal — lebih mendesak & berguna untuk kode ini.
const endsMs = card.endsAt ? Date.parse(card.endsAt) : NaN;
const hasCountdown = !card.perm && Number.isFinite(endsMs) && endsMs > Date.now();

// Badge tanggal 2-baris: label di atas, nilai di bawah (kolom kanan lebih ramping
// → atribusi sumber dapat tempat lebih lebar).
let badge;
if (card.perm) {
  badge = { label: lang === "id" ? "Tanpa batas" : "No expiry", value: null, color: "var(--ok)" };
} else if (card.date) {
  badge = { label: lang === "id" ? "Rilis" : "Released", value: fmtDate(card.date), color: "var(--faint)" };
} else if (card.firstSeenAt) {
  badge = { label: tr("card.seen"), value: fmtDate(card.firstSeenAt), color: "var(--faint)" };
} else {
  badge = { label: "—", value: null, color: "var(--faint)" };
}
---

<article
  class:list={["gg-card", { "gg-new-card": card.isNew }]}
  data-code-card
  data-game={card.game ?? ""}
  data-name={card.name}
  data-search={card.search}
  data-rank={card.rankMs}
  data-seen={card.firstSeenMs}
  data-new={card.isNew ? "1" : "0"}
  style={`background:var(--surface); border:1px solid ${card.isNew ? `rgba(${accentRgb},0.5)` : "var(--line)"}; border-radius:18px; padding:20px; display:flex; flex-direction:column; gap:14px;${card.isNew ? ` box-shadow:0 0 0 1px rgba(${accentRgb},0.12),0 10px 34px rgba(${accentRgb},0.08);` : ""}`}
>
  <div style="display:flex; align-items:center; justify-content:space-between; gap:10px;">
    <div style="display:flex; align-items:center; gap:11px; min-width:0;">
      <span
        style="width:38px; height:38px; border-radius:10px; overflow:hidden; flex:0 0 38px; background:var(--surface2); border:1px solid var(--line); display:block;"
      >
        {
          card.icon ? (
            // onerror: sampai icon diunggah ke public/assets/games/, berkasnya
            // 404 dan menampilkan teks alt yang terpotong jelek. Turunkan ke
            // gradien netral; begitu berkas ada, tampil normal tanpa perubahan.
            <img
              src={card.icon}
              alt={card.name}
              width="38"
              height="38"
              loading="lazy"
              decoding="async"
              style="width:100%; height:100%; object-fit:cover; display:block;"
              onerror="this.style.display='none';this.parentElement.style.background='linear-gradient(135deg,var(--surface2),var(--bg2))';"
            />
          ) : (
            <span
              aria-hidden="true"
              style="width:100%; height:100%; display:block; background:linear-gradient(135deg,var(--surface2),var(--bg2));"
            />
          )
        }
      </span>
      <div style="min-width:0;">
        {
          linkGame && gameHref ? (
            <a href={gameHref} class="gg-game-link" style="display:block; font-size:14.5px; font-weight:700; color:var(--txt); line-height:1.2; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; text-decoration:none;">
              {card.name}
            </a>
          ) : (
            <div style="font-size:14.5px; font-weight:700; color:var(--txt); line-height:1.2; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
              {card.name}
            </div>
          )
        }
      </div>
    </div>
    {/* BARU & Verified menjawab pertanyaan berbeda (seberapa segar vs seberapa
        tepercaya) → tampil BERDAMPINGAN, bukan saling menimpa. "AKTIF" hanya
        muncul bila tak ada keduanya. */}
    <div style="flex:0 0 auto; display:flex; align-items:center; gap:6px;">
      {card.isNew && (
        <span
          class:list={[{ "gg-new": !isAcc2 }]}
          style={`display:inline-flex; align-items:center; gap:5px; font-family:'Space Mono',monospace; font-size:11px; font-weight:700; color:${badgeText}; background:${accent}; border:1px solid ${accent}; padding:4px 9px; border-radius:8px;`}
        >
          <span class="gg-new-dot" aria-hidden="true" style={`width:5px; height:5px; border-radius:50%; background:${badgeText};`} />
          {tr("card.new")}
        </span>
      )}
      {
        card.verified ? (
          /* Verified = kode ini juga dilisting AKTIF oleh situs editorial (cross-check).
             Badge hijau TERISI + centang → sinyal kepercayaan tertinggi. */
          <span style="display:inline-flex; align-items:center; gap:5px; font-family:'Space Mono',monospace; font-size:11px; font-weight:700; color:var(--ink); background:var(--ok); border:1px solid var(--ok); padding:4px 9px; border-radius:8px;">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
            Verified
          </span>
        ) : !card.isNew ? (
          <span style="font-family:'Space Mono',monospace; font-size:11px; font-weight:700; color:var(--ok); background:rgba(55,227,139,0.14); border:1px solid rgba(55,227,139,0.3); padding:4px 9px; border-radius:8px;">
            {tr("card.active")}
          </span>
        ) : null
      }
    </div>
  </div>

  {
    card.reward ? (
      <div style="font-size:13px; color:var(--muted); line-height:1.5;">{card.reward}</div>
    ) : (
      <div style="font-size:12.5px; color:var(--faint); font-style:italic; line-height:1.5;">
        {tr("card.noReward")}
      </div>
    )
  }

  {
    isClaim ? (
      <a
        href={card.claimUrl}
        rel="noopener nofollow"
        target="_blank"
        class="gg-copy"
        style="margin-top:auto; text-align:center; text-decoration:none; font-family:'Space Mono',monospace; font-size:13px; font-weight:700; border:1px solid var(--line2); color:var(--txt); background:var(--surface2); border-radius:10px; padding:11px 12px; transition:all .15s;"
      >
        {tr("card.claim")} ↗
      </a>
    ) : (
      <div style="display:flex; align-items:center; gap:9px; margin-top:auto;">
        <code style={`flex:1; min-width:0; font-family:'Space Mono',monospace; font-size:14px; font-weight:700; letter-spacing:0.05em; color:${accent}; background:var(--bg); border:1px dashed var(--line2); border-radius:10px; padding:10px 12px; text-align:center; overflow:hidden; text-overflow:ellipsis;`}>
          {card.code}
        </code>
        <button
          class="gg-copy"
          data-copy={card.code}
          data-label={tr("card.copy")}
          data-done={tr("card.copied")}
          type="button"
          style="cursor:pointer; font-family:'Space Mono',monospace; font-size:12px; font-weight:700; border:1px solid var(--line2); color:var(--txt); background:var(--surface2); border-radius:10px; padding:10px 13px; transition:all .15s;"
        >
          {tr("card.copy")}
        </button>
      </div>
    )
  }

  <div style="display:flex; align-items:flex-start; justify-content:space-between; border-top:1px solid var(--line); padding-top:12px; gap:8px; min-height:31px;">
    <span style="font-family:'Space Mono',monospace; font-size:11px; line-height:1.35; color:var(--faint);">
      {
        /* Atribusi sumber. Sumber utama ditautkan (sourceUrl — halaman/API
           sumber). Bila kode ditarik dari >1 sumber, sisanya tampil sbg teks
           kredit ("· crimsonwitch"). Sengaja bukan redeemUrl — sebagian game
           (mis. Reverse:1999) redeem in-game & tak punya halaman web. */
        allSources.map((s, i) => (
          <Fragment>
            {i > 0 ? " · " : ""}
            {srcUrl(s) ? (
              <a href={srcUrl(s)} rel="noopener nofollow" target="_blank" style="color:var(--faint); text-decoration:none; border-bottom:1px dotted var(--line2);">
                {s}
              </a>
            ) : (
              s
            )}
          </Fragment>
        ))
      }
    </span>
    {
      hasCountdown ? (
        <span style="display:flex; flex-direction:column; align-items:flex-end; gap:2px; flex:0 0 auto; text-align:right;">
          <span style="font-family:'Space Mono',monospace; font-size:10px; color:var(--faint); white-space:nowrap;">{tr("ev.endsIn")}</span>
          <span data-deadline={card.endsAt} data-ended={lang === "id" ? "Berakhir" : "Ended"} style="font-family:'Space Mono',monospace; font-size:12px; font-weight:700; color:var(--warn); white-space:nowrap;">—</span>
        </span>
      ) : (
        <span style="display:flex; flex-direction:column; align-items:flex-end; gap:2px; flex:0 0 auto; text-align:right;">
          <span style={`font-family:'Space Mono',monospace; font-size:10px; font-weight:700; color:${badge.color}; white-space:nowrap;`}>{badge.label}</span>
          {badge.value && <span style="font-family:'Space Mono',monospace; font-size:12px; font-weight:700; color:var(--faint); white-space:nowrap;">{badge.value}</span>}
        </span>
      )
    }
  </div>
</article>
