---
import Header from "./Header.astro";
import Breadcrumb from "./Breadcrumb.astro";
import Footer from "./Footer.astro";
import { route, langPaths } from "../lib/routes.mjs";

const { lang } = Astro.props;
const id = lang === "id";

const effective = id ? "Berlaku sejak Juli 2026" : "Effective July 2026";
const sections = id
  ? [
      { h: "Ringkasan", p: "KodeGG tidak memungut data pribadi, tidak memakai akun, dan tidak melacak aktivitasmu. Kami hanya menyimpan yang benar-benar diperlukan agar fitur berjalan — dijelaskan di bawah." },
      { h: "Notifikasi push", p: "Kalau kamu mengaktifkan notifikasi (ikon lonceng), browser membuat “push subscription” berisi alamat endpoint + kunci enkripsi. Kami menyimpannya di server (Cloudflare KV) bersama daftar game yang kamu pilih, semata-mata untuk mengirim pemberitahuan saat ada kode redeem baru. Matikan notifikasi kapan saja lewat ikon lonceng — subscription-mu langsung dihapus. Data ini tidak mengidentifikasi dirimu ke kami." },
      { h: "Penyimpanan lokal", p: "Game favorit dan preferensi notifikasi disimpan di browser-mu sendiri (localStorage), tidak dikirim ke kami — kecuali daftar game pilihanmu yang ikut terkirim saat kamu mengaktifkan notifikasi (lihat di atas). Menghapus data situs di browser akan menghapusnya." },
      { h: "Tanpa pelacakan & iklan", p: "Tidak ada Google Analytics, pixel iklan, atau alat pelacak pihak ketiga di KodeGG. Kami tidak membuat profil pengguna dan tidak menjual data apa pun." },
      { h: "Pihak ketiga", p: "Gambar cover game dimuat dari CDN Apple, dan font dari penyedia web font. Pengiriman notifikasi push melewati layanan push browser-mu (mis. Google/Mozilla/Apple) sesuai standar web — kami tidak mengontrol kebijakan mereka." },
      { h: "Kontak", p: "Ada pertanyaan soal privasi atau ingin datamu dihapus? Email support@kodegg.com." },
    ]
  : [
      { h: "Overview", p: "KodeGG collects no personal data, uses no accounts, and doesn't track your activity. We store only what's strictly needed for features to work — explained below." },
      { h: "Push notifications", p: "If you enable notifications (the bell icon), your browser creates a “push subscription” containing an endpoint address + encryption keys. We store it on our server (Cloudflare KV) along with the games you selected, solely to notify you when new redeem codes appear. Turn notifications off anytime via the bell — your subscription is deleted immediately. This data doesn't identify you to us." },
      { h: "Local storage", p: "Your favorite games and notification preferences are kept in your own browser (localStorage), not sent to us — except the list of games you pick, which is sent when you enable notifications (see above). Clearing site data in your browser removes them." },
      { h: "No tracking or ads", p: "There's no Google Analytics, ad pixels, or third-party trackers on KodeGG. We don't build user profiles and don't sell any data." },
      { h: "Third parties", p: "Game cover images load from Apple's CDN, and fonts from a web-font provider. Push delivery goes through your browser's push service (e.g. Google/Mozilla/Apple) per web standards — we don't control their policies." },
      { h: "Contact", p: "Privacy questions, or want your data deleted? Email support@kodegg.com." },
    ];
---

<Header lang={lang} active={null} paths={langPaths("privacy")} />
<Breadcrumb items={[{ label: id ? "Beranda" : "Home", href: route("home", lang) }, { label: id ? "Privasi" : "Privacy" }]} />
<main id="main" style="max-width:820px; margin:0 auto; padding:48px 28px 8px;">
  <h1 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:42px; line-height:1.05; letter-spacing:-0.03em; color:#fff; margin:0 0 6px;">
    {id ? "Kebijakan Privasi" : "Privacy Policy"}
  </h1>
  <p style="font-family:'Space Mono',monospace; font-size:12px; color:var(--faint); margin:0 0 26px;">{effective}</p>
  {
    sections.map((s) => (
      <section style="margin-bottom:26px;">
        <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:20px; color:var(--txt); margin:0 0 8px;">{s.h}</h2>
        <p style="font-size:15.5px; line-height:1.7; color:var(--muted); margin:0; max-width:70ch;">{s.p}</p>
      </section>
    ))
  }
</main>
<Footer lang={lang} updatedAt={null} />
