# dependencies
node_modules/
# build output
site/dist/
site/.astro/
# aset icon hasil fetch (di-generate worker, jangan commit besar-besar) — opsional
# (biarkan ter-commit kalau mau deploy tanpa jalanin fetch-icons dulu)
# data efemeral: daftar kode baru per-run (untuk notifikasi push, tak di-commit)
worker/data/new-codes.json
# laporan pemantau sumber (1x/hari) — hasilnya dibaca dari ringkasan run, jangan bikin commit/deploy tiap hari
worker/data/source-report.json
# kredensial lokal (upload manual YouTube)
worker/.env

# logs & temp
*.log
.DS_Store

